{
  "name": "webtorrent-desktop",
  "description": "WebTorrent, the streaming torrent client. For macOS.",
  "version": "0.25.5",
  "author": {
    "name": "WebTorrent, LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "babel src --out-dir build --delete-dir-on-start --ignore \"src/renderer/main.js,src/renderer/components/**/*,src/renderer/controllers/**/*,src/renderer/pages/**/*\"",
    "build:renderer": "vite build",
    "build:tauri": "npm run build && node ./bin/build-tauri.js",
    "tauri:build": "tauri build",
    "package": "npm run build:tauri && tauri build",
    "clean": "node ./bin/clean.js",
    "gh-release": "gh-release",
    "open-config": "node ./bin/open-config.js",
    "start": "npm run build:tauri && tauri dev",
    "test": "npm run lint && depcheck --ignores=standard,eslint,@babel/eslint-parser,madr,buffer,nightralph --ignore-dirs=build,build-vite,build-tauri,build-sidecar,dist && npm run test-unit",
    "test-unit": "npm run build && tape test/unit/*.js",
    "lint": "standard && npm run lint:boundary",
    "lint:boundary": "eslint --no-eslintrc -c eslint-boundary.config.js src/renderer src/engine",
    "update-authors": "./bin/update-authors.sh",
    "watch": "nodemon --exec \"npm run start\" --ext js,css --ignore build/ --ignore build-vite/ --ignore build-tauri/ --ignore build-sidecar/ --ignore dist/",
    "preversion": "npm run lint",
    "version": "node ./bin/sync-crate-version.js && git add src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "postversion": "git push --follow-tags"
  },
  "babel": {
    "sourceType": "unambiguous",
    "plugins": [
      [
        "@babel/plugin-transform-react-jsx",
        {
          "useBuiltIns": true
        }
      ],
      "@babel/plugin-transform-modules-commonjs"
    ]
  },
  "bugs": {
    "url": "https://github.com/webtorrent/webtorrent-desktop/issues"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "application-config": "2.0.0",
    "arch": "2.2.0",
    "bitfield": "4.1.0",
    "buffer": "6.0.3",
    "create-torrent": "5.0.9",
    "debounce": "1.2.1",
    "drag-drop": "7.2.0",
    "es6-error": "4.1.1",
    "fn-getter": "1.0.0",
    "iso-639-1": "2.1.15",
    "languagedetect": "2.0.0",
    "location-history": "1.1.2",
    "material-ui": "0.20.2",
    "music-metadata": "7.14.0",
    "network-address": "1.1.2",
    "parse-torrent": "9.1.5",
    "prettier-bytes": "1.0.4",
    "prop-types": "15.8.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "rimraf": "4.4.0",
    "run-parallel": "1.2.0",
    "semver": "7.3.8",
    "simple-concat": "1.0.1",
    "srt-to-vtt": "1.1.3",
    "webtorrent": "1.9.7",
    "ws": "7.5.9"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@tauri-apps/cli": "2.11.4",
    "depcheck": "1.4.7",
    "eslint": "8.15.0",
    "gh-release": "7.0.2",
    "madr": "^4.0.0",
    "nightralph": "^0.1.1",
    "nodemon": "2.0.22",
    "open": "8.4.2",
    "standard": "17.0.0",
    "tape": "5.10.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "homepage": "https://webtorrent.io",
  "keywords": [
    "desktop",
    "hybrid webtorrent client",
    "mad science",
    "torrent",
    "torrent client",
    "webtorrent"
  ],
  "license": "MIT",
  "private": true,
  "productName": "WebTorrent",
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/webtorrent-desktop.git"
  },
  "standard": {
    "parser": "@babel/eslint-parser"
  },
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  }
}
