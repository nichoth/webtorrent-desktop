// watch.\n///\n/// The file is re-read here rather than at launch, so that picking a\n/// different folder and switching the preference back on takes effect\n/// without a restart.\nfn watch_folder(app: &AppHandle) {\n    let paths = app.state::<AppPaths>();\n    let prefs = watcher::saved_prefs(&window::read_saved_state(&paths.config_path));\n    let folder_watcher = app.state::<FolderWatcher>();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NU34bVNqHstABPCRZjdRQF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
