{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MmijGLr7LuCFPecdBueuiQ","type":"tool_result","content":"const test = require('tape')\nconst fs = require('fs')\nconst path = require('path')\n\n// What the shim does not implement yet.\n//\n// ADR-014 planned for the window to be partly broken for most of Phase\n// 4: an export whose host side has not been written throws a named\n// `NotImplementedError` rather than returning `undefined`, so an\n// unported concern is one console line rather than a plausible value\n// that fails somewhere unrelated.\n//\n// This file was `platform-tauri.js` until US-072, where it checked\n// that the Electron and Tauri trees exported the same names with the\n// same arities and that the `WT_HOST` resolver swapped one for the\n// other. There is one tree now, so the parity half has nothing to\n// compare and the resolver is gone. What survives is the half that is\n// still load-bearing: the register below, and the sweep that keeps it\n// honest in both directions.\n//\n// **Adding a name here is not how a story finishes.** The register\n// shrinks; it never grows. Each entry names the story that owes it.\n\nconst REPO = path.join(__dirname, '..', '..')\nconst SRC_SHIM = path.join(REPO, 'src', 'renderer', 'lib', 'platform')\nconst BUILT_SHIM = path.join(\n  REPO, 'build', 'renderer', 'lib', 'platform'\n)\n\n// Not shim modules: the barrel and the shared failure helper.\nconst HELPERS = ['index.js', 'not-implemented.js']\n\nconst UNIMPLEMENTED = {\n  'ipc-os.js': [\n    // US-065: the file and magnet open events, and the two signals the\n    // host waits on before it shows the window and before it quits.\n    'signalReady',\n    'signalStateSaved',\n    'openTorrentFileDialog',\n    'openFilesDialog',\n    // US-064: registering as the .torrent and magnet handler.\n    'setDefaultFileHandler',\n    // The host's log and error channels. `src-tauri/src/log.rs` writes\n    // the host's own; nothing emits these to the renderer yet.\n    'onLog',\n    'onError'\n  ]\n}\n\nconst { NOT_IMPLEMENTED } = require(\n  path.join(BUILT_SHIM, 'not-implemented')\n)\n\nfunction modules () {\n  return fs.readdirSync(SRC_SHIM)\n    .filter((name) => name.endsWith('.js') && !HELPERS.includes(name))\n    .sort()\n}\n\nfunction unimplemented (name) {\n  return UNIMPLEMENTED[name] || []\n}\n\n// The source is the authority on which exports are stubs; the register\n// above is the claim about it. Comparing the two is what makes a story\n// that implements an export -- or regresses one -- fail here.\nfunction stubsIn (name) {\n  const source = fs.readFileSync(path.join(SRC_SHIM, name), 'utf8')\n  const found = []\n  const re = /export (?:async )?function (\\w+)\\s*\\([^)]*\\)\\s*\\{([^}]*)\\}/g\n  let m\n  while ((m = re.exec(source))) {\n    if (m[2].includes('notImplemented(')) found.push(m[1])\n  }\n  return found.sort()\n}\n\ntest('the register lists exactly the stubs in the source', function (t) {\n  const names = modules()\n  t.ok(names.length > 5, 'walked the shim')\n----\nconst test = require('tape')\n\n// US-056: the first shim export with the Rust host behind it.\n//\n// `onWindowBoundsChanged` is the renderer's half of the window\n// restore loop: the host emits the rectangle on the same event name\n// the Electron main process used to send it on, and the renderer\n// saves what it receives. What is asserted here is the shim's side of that\n// contract -- the event name, the payload the caller sees, and the\n// unsubscribe function every listener export resolves to.\n//\n// Same `require.cache` stub route as `platform-dialog.js`; see\n// `test/AGENTS.md`. The stub's exports object is bound once, at the\n// first require of the module under test, so the recording state\n// lives behind stable functions rather than being rebuilt.\n\nconst eventPath = require.resolve('@tauri-apps/api/event')\nconst corePath = require.resolve('@tauri-apps/api/core')\n\nlet calls = []\nlet unsubscribe = () => {}\n\nlet invocations = []\nlet answer\n\nrequire.cache[eventPath] = {\n  id: eventPath,\n  filename: eventPath,\n  loaded: true,\n  exports: {\n    __esModule: true,\n    async listen (name, handler) {\n      calls.push({ api: 'listen', name, handler })\n      return unsubscribe\n    },\n    async once (name, handler) {\n      calls.push({ api: 'once', name, handler })\n      return unsubscribe\n    }\n  }\n}\n\n// US-057 added the window-control half, which is commands rather than\n// events. This file requires `platform/ipc-os` first in the glob, so this\n// is the `invoke` that module binds for the whole run -- a later file\n// seeding its own core stub (`platform-window.js` does) gets a fresh\n// entry for its own module and leaves this one alone.\n//\n// The reference is kept here rather than read back out of\n// `require.cache` at use, because that later file overwrites the\n// entry: the cache holds *its* stub by then, and `ipc-os` holds this\n// one.\nconst core = {\n  __esModule: true,\n  async invoke (command, args) {\n    invocations.push({ command, args })\n    return answer\n  }\n}\n\nrequire.cache[corePath] = {\n  id: corePath,\n  filename: corePath,\n  loaded: true,\n  exports: core\n}\n\nconst ipcOs = require('../../build/renderer/lib/platform/ipc-os')\n\nfunction reset () {\n  calls = []\n  unsubscribe = () => {}\n  invocations = []\n  answer = undefined\n}\n\ntest('onWindowBoundsChanged subscribes to the host event',\n  async function (t) {\n    reset()\n    await ipcOs.onWindowBoundsChanged(() => {})\n---\n77:test('onWindowBoundsChanged subscribes to the host event',\n89:test('onWindowBoundsChanged hands the caller the payload alone',\n103:test('onWindowBoundsChanged resolves to an unsubscribe function',\n116:test('onWindowBoundsChanged honours { once: true }', async function (t) {\n125:test('onWindowBoundsChanged returns a promise', function (t) {\n142:test('setTitle sends the title to the host', async function (t) {\n153:test('setProgress s