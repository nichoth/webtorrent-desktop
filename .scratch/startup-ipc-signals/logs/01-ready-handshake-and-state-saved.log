{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cfyg98qPyebPniFNf1WDt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GnaYe2cYz3L8v9q8MiA1vr","name":"Write","input":{"file_path":"/Users/nick/code/webtorrent-desktop.startup-ipc-signals-01-ready-handshake-and-state-saved/src-tauri/src/ready.rs","content":"//! Whether the UI has said it is listening.\n//!\n//! This is the host's half of `ipcMain.once('ipcReady')` in\n//! `src/main/ipc.js`. The renderer registers its host and engine\n//! listeners at startup and then calls `ipcOs.signalReady()`, which is\n//! the `ipc_ready` command in `main.rs`; that command is the only\n//! thing that sets the record kept here.\n//!\n//! Nothing reads it yet. US-065 will: a file or magnet open event that\n//! arrives before the UI is listening has to be queued rather than\n//! emitted into a webview that drops it, and [`Readiness::is_ready`] is\n//! the question it asks first.\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn starts_not_ready() {\n        assert!(!Readiness::default().is_ready());\n    }\n\n    #[test]\n    fn is_ready_after_the_signal() {\n        let readiness = Readiness::default();\n        readiness.signal();\n        assert!(readiness.is_ready());\n    }\n\n    /// A webview reload runs startup again, so the signal arrives a\n    /// second time. That is not an error, and it does not undo the\n    /// first.\n    #[test]\n    fn a_repeated_signal_leaves_it_ready() {\n        let readiness = Readiness::default();\n        readiness.signal();\n        readiness.signal();\n        assert!(readiness.is_ready());\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1699,"cache_read_input_tokens":68699,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1699},"output_tokens":55,"service_tier":"stand