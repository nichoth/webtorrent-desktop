 and the renderer only ever says \"start\"\n// or \"stop\". That stays true here: neither command carries anything,\n// and the torrents it finds arrive on the `dispatch` event above as\n// `addTorrent`, which is the channel the Electron host dispatches on\n// too.\n\ntest('the folder watcher commands take no arguments', async function (t) {\n  reset()\n  await ipcOs.startFolderWatcher()\n  await ipcOs.stopFolderWatcher()\n\n  t.deepEqual(invocations.map(c => c.command),\n    ['start_folder_watcher', 'stop_folder_watcher'],\n    'one command each')\n  t.deepEqual(invocations.map(c => c.args), [undefined, undefined],\n    'the host reads the folder out of the saved state, as Electron does')\n  t.end()\n})\n\ntest('a folder watcher failure reaches the caller', async function (t) {\n  })\n\ntest('openExternalPlayer with no configured player sends null',\n  async function (t) {\n    reset()\n    // `undefined` rather than `null`: JSON drops the key altogether,\n    // and a dropped key is not a value the host can read. Both shapes\n    // have to arrive as `null`, which is what makes the host look for\n    // VLC rather than guess from an argument that is not there.\n    await ipcOs.openExternalPlayer(undefined, 'http://127.0.0.1:5000/0', 'Sintel')\n\n    t.ok('path' in invocations[0].args, 'the key crosses at all')\n    t.equal(invocations[0].args.path, null,\n      'which is what makes the host go looking for VLC')\n    t.equal(invocations[0].args.title, 'Sintel', 'the title still crosses')\n\n    reset()\n    await ipcOs.openExternalPlayer(null, 'http://127.0.0.1:5000/0', 'Sintel')\n    t.equal(invocations[0].args.path, null, 'and an explicit null is the same')\n    t.end()\n  })\n\ntest('quitExternalPlayer asks the host to kill it', async function (t) {\n  reset()\n  await ipcOs.quitExternalPlayer()\n\n  t.deepEqual(invocations, [{ command: 'quit_external_player', args: undefined }],\n    'one command, no arguments')\n  t.end()\n})\n\ntest('a failed launch reaches the caller', async function (t) {\n  reset()\n  const real = core.invoke\n  core.invoke = async () => { throw new Error('spawn: no such file') }\n\n  try {\n    await ipcOs.openExternalPlayer('/nope', 'http://x/0', 'x')\n    t.fail('resolved over a host failure')\n  } catch (err) {\n    t.equal(err.message, 'spawn: no such file',\n      'reportErrors() gets something to show')\n  }\n\n  core.invoke = real\n  t.end()\n})\n11:    \"build\": \"npm run build:node && npm run build:renderer\",\n12:    \"build:node\": \"babel src --out-dir build --delete-dir-on-start --ignore \\\"src/renderer/main.js,src/renderer/components/**/*,src/renderer/controllers/**/*,src/renderer/pages/**/*\\\"\",\n13:    \"build:renderer\": \"vite build\",\n14:    \"build:tauri\": \"npm run build && node ./bin/build-tauri.js\",\n21:    \"test\": \"npm run lint && depcheck --ignores=standard,eslint,@babel/eslint-parser,madr,buffer --ignore-dirs=build,build-vite,build-tauri,build-sidecar,dist && npm run test-unit\",\n22:    \"test-unit\": \"npm run build && tape test/unit/*.js\",\n//! Keeping the display awake while something is playing.\n//!\n//! This is the Rust half of `src/main/power-save-blocker.js`, whose\n//! whole content is Electron's `powerSaveBlocker` plus the two\n//! `isStarted` guards that make `enable` and `disable` idempotent.\n//! Tauri has no equivalent API, so the guards live in\n//! [`PowerSaveBlocker`] here and each platform's way of holding the\n//! display awake is a [`Wake`] behind it.\n//!\n//! The split is the one [`crate::dock`] uses: what a platform *does*\n//! is a decision over plain values ([`strategy`]), asserted for all\n//! three platforms from one `cargo test` run, and the part that\n//! touches the world is at the bottom of the file. The bookkeeping\n//! that Electron's two guards are -- enable once, release exactly\n//! once, never leak -- is tested against a fake [`Wake`], because that\n//! is the half a leak would come from.\n\nuse std::sync::Mutex;\n\nuse crate::menu::Platform;\n\n/// Electron's `powerSaveBlocker.start('prevent-display-sleep')`, which\n/// is the only type `src/main/power-save-blocker.js` asks for.\n///\n/// The name each platform shows the user for the assertion it is\n/// holding: `pmset -g assertions` on macOS, `systemd-inhibit --list`\n/// on Linux.\nconst WHY: &str = \"WebTorrent Desktop is playing media\";\n\n/// How this platform holds the display awake.\n///\n/// Electron reaches one API on all three; there is no such API here,\n/// so each platform is named rather than left to a fallback that\n/// would quietly do nothing.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Strategy {\n    /// macOS: an IOKit power assertion of type\n    /// `PreventUserIdleDisplaySleep`, which is exactly what Electron's\n    /// `prevent-display-sleep` takes out. It belongs to this process\n    /// and dies with it.\n    Assertion,\n    /// Windows: `ES_DISPLAY_REQUIRED`, which is per-thread, so the\n    /// thread that sets it is held for as long as the block lasts. It\n    /// dies with the process too.\n    ExecutionState,\n    /// Linux: a `systemd-inhibit` child holding an `idle` lock. See\n    /// [`inhibit_command`] for why it is a child process rather than a\n    /// D-Bus call.\n    Inhibit,\n}\n\n/// What [`PowerSaveBlocker::platform`] builds on this platform.\npub fn strategy(platform: Platform) -> Strategy {\n    match platform {\n        Platform::Mac => Strategy::Assertion,\n        Platform::Windows => Strategy::ExecutionState,\n        Platform::Linux => Strategy::Inhibit,\n    }\n}\n\n/// The `systemd-inhibit` invocation [`Strategy::Inhibit`] holds open.\n///\n/// `--what=idle` is the closest lock to `prevent-display-sleep`: it\n/// stops the session going idle, which is what turns the display off.\n///\n/// The lock lasts as long as the child does, and the child is `cat`\n/// reading a pipe this process holds the write end of. That is the\n/// point of `cat` rather than `sleep`: if this process dies without\n/// running its cleanup, the pipe closes, `cat` sees end-of-file and\n/// exits, and the lock goes with it. An inhibitor that outlives the\n/// app that took it out is the one failure mode here that a user\n/// cannot see and cannot undo.\npub fn inhibit_command() -> (&'static str, Vec<String>) {\n    (\n        \"systemd-inhibit\",\n        vec![\n            \"--what=idle\".to_string(),\n            \"--who=WebTorrent Desktop\".to_string(),\n            format!(\"--why={WHY}\"),\n            \"--mode=block\".to_string(),","is_error":false}]},"parent_tool_use_id":null,"session_id":"d368e2bc-7539-4837-935c-d1f3167fa8da","uuid":"42619b36-3574-47a8-9bc9-9b1a769cdcf0","timestamp":"2026-10-13T05:26:16.581Z","tool_use_result":{"stdout":"    { command: 'set_allow_nav', args: { allow: true } }\n  ], 'one command per call, carrying the flag')\n  t.end()\n})\n\ntest('the player open and close notifications take no arguments',\n  async function (t) {\n    reset()\n    await ipcOs.notifyPlayerOpen()\n    await ipcOs.notifyPlayerClose()\n\n    t.deepEqual(invocations.map(c => c.command),\n      ['notify_player_open', 'notify_player_close'],\n      'the two commands that turn the Playback items on and off')\n    t.deepEqual(invocations.map(c => c.args), [undefined, undefined],\n      'neither carries anything')\n    t.end()\n  })\n\n// US-066: the two the power save blocker is the whole content of.\n// `notifyPlayerOpen` and `notifyPlayerClose` reach commands that do the\n// same thing among others, which is how `src/main/ipc.js` has it.\ntest('the play and pause notifications take no arguments either',\n  async function (t) {\n    reset()\n    await ipcOs.notifyPlayerPlay()\n    await ipcOs.notifyPlayerPause()\n\n    t.deepEqual(invocations.map(c => c.command),\n      ['notify_player_play', 'notify_player_pause'],\n      'the two commands that hold the display awake and let it go')\n    t.deepEqual(invocations.map(c => c.args), [undefined, undefined],\n      'neither carries anything')\n    t.end()\n  })\n\ntest('notifyPlayerUpdate carries both playlist flags', async function (t) {\n  reset()\n  await ipcOs.notifyPlayerUpdate(true, false)\n\n  t.deepEqual(invocations, [{\n    command: 'notify_player_update',\n    args: { hasNext: true, hasPrevious: false }\n  }], 'camelCase keys, which is how the host reads its snake_case ones')\n  t.end()\n})\n\ntest('onDispatch subscribes to the host event', async function (t) {\n  reset()\n  const stop = await ipcOs.onDispatch(() => {})\n\n// `src/main/folder-watcher.js` reads the folder and the preference out\n// of the saved state itself, and the renderer only ever says \"start\"\n// or \"stop\". That stays true here: neither command carries anything,\n// and the torrents it finds arrive on the `dispatch` event above as\n// `addTorrent`, which is the channel the Electron host dispatches on\n// too.\n\ntest('the folder watcher commands take no arguments', async function (t) {\n  reset()\n  await ipcOs.startFolderWatcher()\n  await ipcOs.stopFolderWatcher()\n\n  t.deepEqual(invocations.map(c => c.command),\n    ['start_folder_watcher', 'stop_folder_watcher'],\n    'one command each')\n  t.deepEqual(invocations.map(c => c.args), [undefined, undefined],\n    'the host reads the folder out of the saved state, as Electron does')\n  t.end()\n})\n\ntest('a folder watcher failure reaches the caller', async function (t) {\n  })\n\ntest('openExternalPlayer with no configured player sends null',\n  async function (t) {\n    reset()\n    // `undefined` rather than `null`: JSON drops the key altogether,\n    // and a dropped key is not a value the host can read. Both shapes\n    // have to arrive as `null`, which is what makes the host look for\n    // VLC rather than guess from an argument that is not there.\n    await ipcOs.openExternalPlayer(undefined, 'http://127.0.0.1:5000/0', 'Sintel')\n\n    t.ok('path' in invocations[0].args, 'the key crosses at all')\n    t.equal(invocations[0].args.path, null,\n      'which is what makes the host go looking for VLC')\n    t.equal(invocations[0].args.title, 'Sintel', 'the title still crosses')\n\n    reset()\n    await ipcOs.openExternalPlayer(null, 'http://127.0.0.1:5000/0', 'Sintel')\n    t.equal(invocations[0].args.path, null, 'and an explicit null is the same')\n    t.end()\n  })\n\ntest('quitExternalPlayer asks the host to kill it', async function (t) {\n  reset()\n  await ipcOs.quitExternalPlayer()\n\n  t.deepEqual(invocations, [{ command: 'quit_external_player', args: undefined }],\n    'one command, no arguments')\n  t.end()\n})\n\ntest('a failed launch reaches the caller', async function (t) {\n  reset()\n  const real = core.invoke\n  core.invoke = async () => { throw new Error('spawn: no such file') }\n\n  try {\n    await ipcOs.openExternalPlayer('/nope', 'http://x/0', 'x')\n    t.fail('resolved over a host failure')\n  } catch (err) {\n    t.equal(err.message, 'spawn: no such file',\n      'reportErrors() gets something to show')\n  }\n\n  core.invoke = real\n  t.end()\n})\n11:    \"build\": \"npm run build:node && npm run build:renderer\",\n12:    \"build:node\": \"babel src --out-dir build --delete-dir-on-start --ignore \\\"src/renderer/main.js,src/renderer/components/**/*,src/renderer/controllers/**/*,src/renderer/pages/**/*\\\"\",\n13:    \"build:renderer\": \"vite build\",\n14:    \"build:tauri\": \"npm run build && node ./bin/build-tauri.js\",\n21:    \"test\": \"npm run lint && depcheck --ignores=standard,eslint,@babel/eslint-parser,madr,buffer --ignore-dirs=build,build-vite,build-tauri,build-sidecar,dist && npm run test-unit\",\n22:    \"test-unit\": \"npm run build && tape test/unit/*.js\",\n//! Keeping the display awake while something is playing.\n//!\n//! This is the Rust half of `src/main/power-save-blocker.js`, whose\n//! whole content is Electron's `powerSaveBlocker` plus the two\n//! `isStarted` guards that make `enable` and `disable` idempotent.\n//! Tauri has no equivalent API, so the