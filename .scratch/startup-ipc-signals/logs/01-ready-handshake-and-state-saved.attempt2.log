{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfygUdCyobvsUqevGoiFp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AMVX4srxZ5bYphjfzgtjw4","name":"Write","input":{"file_path":"/Users/nick/code/webtorrent-desktop.startup-ipc-signals-01-ready-handshake-and-state-saved/src-tauri/src/ready.rs","content":"//! Whether the UI is listening yet.\n//!\n//! The renderer registers its host and engine listeners at startup and\n//! then calls `ipcOs.signalReady`, which is the `ipc_ready` command.\n//! Under Electron that was the `ipcReady` message `src/main/ipc.js`\n//! waited on before sending the file and magnet open events the app\n//! was launched with. Those events are US-065's; this is the record\n//! they will consult, so that one sent before the UI can hear it is\n//! queued rather than lost.\n//!\n//! A webview reload runs startup again and signals again. That is not\n//! an error: the UI is ready either way.\n\nuse std::sync::atomic::{AtomicBool, Ordering};\n\n/// Whether the UI has signalled ready. It starts not ready, and once\n/// ready it stays ready.\n#[derive(Debug, Default)]\npub struct Readiness(AtomicBool);\n\nimpl Readiness {\n    /// The UI's listeners are registered.\n    pub fn signal(&self) {\n        self.0.store(true, Ordering::SeqCst);\n    }\n\n    /// Has the UI signalled ready? Nothing reads it until US-065\n    /// delivers the open events, which is why it is allowed to be dead\n    /// code until then.\n    #[allow(dead_code)]\n    pub fn is_ready(&self) -> bool {\n        self.0.load(Ordering::SeqCst)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn starts_not_ready() {\n        assert!(!Readiness::default().is_ready());\n    }\n\n    #[test]\n    fn is_ready_after_the_signal() {\n        let ready = Readiness::default();\n        ready.signal();\n        assert!(ready.is_ready());\n    }\n\n    #[test]\n    fn a_repeated_signal_leaves_it_ready() {\n        let ready = Readiness::default();\n        ready.signal();\n        ready.signal();\n        assert!(ready.is_ready());\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2833,"cache_read_input_tokens":60560,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2833},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d368e2bc-7539-4837-935c-d1f3167fa8da","uuid":"f82237f2-5aaa-41a3-b666-95b317a31014","timestamp":"2026-10-13T05:26:30.314Z","request_id":"req_011CfygUcx6f9PU8iAUt4uJC","wire_tool_inputs":{"toolu_01AMVX4srxZ5bYphjfzgtjw4":{"file_path":"/Users/nick/code/webtorrent-desktop.startup-ipc-signals-01-ready-handshake-and-state-saved/src-tauri/src/ready.rs","content":"//! Whether the UI is listening yet.\n//!\n//! The renderer registers its host and engine listeners at startup and\n//! then calls `ipcOs.signalReady`, which is the `ipc_ready` command.\n//! Under Electron that was the `ipcReady` message `src/main/ipc.js`\n//! waited on before sending the file and magnet open events the app\n//! was launched with. Those events are US-065's; this is the record\n//! they will consult, so that one sent before the UI can hear it is\n//! queued rather than lost.\n//!\n//! A webview reload runs startup again and signals again. That is not\n//! an error: the UI is ready either way.\n\nuse std::sync::atomic::{AtomicBool, Ordering};\n\n/// Whether the UI has signalled ready. It starts not ready, and once\n/// ready it stays ready.\n#[derive(Debug, Default)]\npub struct Readiness(AtomicBool);\n\nimpl Readiness {\n    /// The UI's listeners are registered.\n    pub fn signal(&self) {\n        self.0.store(true, Ordering::SeqCst);\n    }\n\n    /// Has the UI signalled ready? Nothing reads it until US-065\n    /// delivers the open events, which is why it is allowed to be dead\n    /// code until then.\n    #[allow(dead_code)]\n    pub fn is_ready(&self) -> bool {\n        self.0.load(Ordering::SeqCst)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn starts_not_ready() {\n        assert!(!Readiness::default().is_ready());\n    }\n\n    #[test]\n    fn is_ready_after_the_signal() {\n        let ready = Readiness::default();\n        ready.signal();\n        assert!(ready.is_ready());\n    }\n\n    #[test]\n    fn a_repeated_signal_leaves_it_ready() {\n        let ready = Readiness::default();\n        ready.signal();\n        ready.signal();\n        assert!(ready.is_ready());\n    }\n}\n"}}}
