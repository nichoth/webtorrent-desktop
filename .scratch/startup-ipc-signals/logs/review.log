ing')\n+    t.end()\n+  })\n+\n // -- the dock and the taskbar (US-063) --------------------------------\n //\n // `setProgress` above is the third of the three, and was already the\ndiff --git a/test/unit/platform-stubs.js b/test/unit/platform-stubs.js\nindex e8b2f88..e32b625 100644\n--- a/test/unit/platform-stubs.js\n+++ b/test/unit/platform-stubs.js\n@@ -32,18 +32,11 @@ const HELPERS = ['index.js', 'not-implemented.js']\n \n const UNIMPLEMENTED = {\n   'ipc-os.js': [\n-    // US-065: the file and magnet open events, and the two signals the\n-    // host waits on before it shows the window and before it quits.\n-    'signalReady',\n-    'signalStateSaved',\n+    // US-065: the open-torrent and open-files dialogs.\n     'openTorrentFileDialog',\n     'openFilesDialog',\n     // US-064: registering as the .torrent and magnet handler.\n-    'setDefaultFileHandler',\n-    // The host's log and error channels. `src-tauri/src/log.rs` writes\n-    // the host's own; nothing emits these to the renderer yet.\n-    'onLog',\n-    'onError'\n+    'setDefaultFileHandler'\n   ]\n }\n \ndiff --git a/test/unit/renderer-boots.js b/test/unit/renderer-boots.js\nindex d06ee85..b184df7 100644\n--- a/test/unit/renderer-boots.js\n+++ b/test/unit/renderer-boots.js\n@@ -84,8 +84,13 @@ function webviewSandbox (invoked = [], answer = null) {\n     addEventListener () {}, removeEventListener () {}, dispatchEvent () {}\n   })\n \n+  // Element-shaped enough for `ReactDOM.render` to accept one as its\n+  // container, which is as far as the clean-boot test below needs it.\n   function element () {\n-    return Object.assign(listeners(), {\n+    const node = Object.assign(listeners(), {\n+      nodeType: 1,\n+      nodeName: 'DIV',\n+      tagName: 'DIV',\n       style: {},\n       classList: { add () {}, remove () {}, contains: () => false },\n       dataset: {},\n@@ -106,6 +111,10 @@ function webviewSandbox (invoked = [], answer = null) {\n       focus () {},\n       blur () {}\n     })\n+  