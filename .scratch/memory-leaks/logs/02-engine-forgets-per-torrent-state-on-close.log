nnounceAt.set(torrent.infoHash, Date.now())\n327:  torrent.on('metadata', torrentMetadata)\n328:  torrent.on('ready', torrentReady)\n329:  torrent.on('done', torrentDone)\n407:  let stats = corruptPeerStats.get(torrent.infoHash)\n410:    corruptPeerStats.set(torrent.infoHash, stats)\n500:    const corrupt = corruptPeerStats.get(torrent.infoHash)\n516:    const motion = stalls.sample(torrent.infoHash, {\n./AGENTS.md\n./test/AGENTS.md\n./src-tauri/AGENTS.md\n./src/AGENTS.md\n./src/shared/AGENTS.md\n./src/engine/AGENTS.md\n./src/renderer/pages/AGENTS.md\n./src/renderer/components/AGENTS.md\n./src/renderer/controllers/AGENTS.md\n./src/renderer/lib/platform/AGENTS.md\n  \"scripts\": {\n    \"build\": \"npm run build:node && npm run build:renderer\",\n    \"build:node\": \"babel src --out-dir build --delete-dir-on-start --ignore \\\"src/renderer/main.js,src/renderer/components/**/*,src/renderer/controllers/**/*,src/renderer/pages/**/*\\\"\",\n    \"build:renderer\": \"vite build\",\n    \"build:tauri\": \"npm run build && node ./bin/build-tauri.js\",\n    \"tauri:build\": \"tauri build\",\n    \"package\": \"npm run build:tauri && tauri build\",\n    \"clean\": \"node ./bin/clean.js\",\n    \"gh-release\": \"gh-release\",\n    \"open-config\": \"node ./bin/open-config.js\",\n    \"start\": \"npm run build:tauri && tauri dev\",\n    \"test\": \"npm run lint && depcheck --ignores=standard,eslint,@babel/eslint-parser,madr,buffer,nightralph --ignore-dirs=build,build-vite,build-tauri,build-sidecar,dist && npm run test-unit\",\n    \"test-unit\": \"npm run build && tape test/unit/*.js\",\n    \"lint\": \"standard && npm run lint:boundary\",\n    \"lint:boundary\": \"eslint --no-eslintrc -c eslint-boundary.config.js src/renderer src/engine\",\n    \"update-authors\": \"./bin/update-authors.sh\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Kn5aASn91xzzeLEjGxTFGA","permission_decision":{"decision":"accept","source":