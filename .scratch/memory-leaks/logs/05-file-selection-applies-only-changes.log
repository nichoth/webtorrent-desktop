tream\\(\\)/.test(body),\n      'and the handler opens no stream of its own')\n    t.end()\n  })\nmemory-leaks/\nstartup-ipc-signals/","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014LBkdZZTBNfquEgNYJAQ22","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
