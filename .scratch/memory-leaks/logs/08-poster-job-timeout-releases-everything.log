posterFileName), bytes)\n  console.log('saved poster %s', posterFileName)\n  return posterFileName\n}\n\n/**\n * Ask the engine for this torrent's streaming server and wait for its\n * URL. wt-start-server is idempotent per torrent and always replies,\n * so this resolves whether or not a server was already up (ADR-013).\n *\n * Records the subscription and the hold on `job`, so the job can undo\n * both if it gives up first. Asks for nothing once the job is over.\n */\nasync function startServer (infoHash, job) {\n  try {\n    return await new Promise((resolve, reject) => {\n      ipcEngine.onServerRunningFor(\n        infoHash, (info) => resolve(info.localURL), { once: true }\n      ).then((off) => {\n        if (job.over) return off()\n        job.unsubscribe = off\n        job.heldServer = true\n        return ipcEngine.startServer(infoHash)\n      }).catch(reject)\n    })\n  } finally {\n    if (job.unsubscribe) job.unsubscribe()\n    job.unsubscribe = null\n  }\n}\n\n'''\ns=s[:a]+new+s[b:]\nopen(p,'w').write(s)\nEOF\nnpm run build:node >/dev/null 2>&1 && npx tape test/unit/poster.js 2>&1 | grep -E '^(not ok|# (tests|pass|fail))'"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1635,"cache_read_input_tokens":65302,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1635},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ce97d0a-4afe-4640-b390-742b9e181571","uuid":"56c61b2d-7806-4f42-8fdb-ab25003187ba","timestamp":"2026-10-18T01:28:29.687Z","request_id":"req_011Cg8qNRDKtjeK36RLP211G","wire_tool_inputs":{"toolu_01CGpyYZPucwn9bMqsbWsWrr":{"command":"python3 - <<'EOF'\np='src/renderer/lib/torrent-poster.js'\ns=open(p).read()\na=s.index(\"  // What this job holds, so it can let g