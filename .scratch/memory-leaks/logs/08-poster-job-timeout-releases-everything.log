s removed')\n    t.deepEqual(record.fs, [], 'nothing was written')\n    t.end()\n  })\n\"\"\"\nopen(p,'w').write(s)\nEOF\nnpm run build:node >/dev/null 2>&1 && npx tape test/unit/poster.js 2>&1 | grep -E '^(not ok|# (tests|pass|fail))|^# poster: a (timed|job)' -A3 | grep -v '^ok'"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":308,"cache_read_input_tokens":63031,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":308},"output_tokens":35,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ce97d0a-4afe-4640-b390-742b9e181571","uuid":"fa513f06-f979-45b5-a335-2ad128bd1885","timestamp":"2026-10-18T01:28:13.738Z","request_id":"req_011Cg8qM6tUXvLYF51iq6cz3","wire_tool_inputs":{"toolu_016vA3BoTSVQBHMzx7x6M74M":{"command":"python3 - <<'EOF'\np='test/unit/poster.js'\ns=open(p).read()\nold=\"\"\"    record.engine.push(['onServerRunningFor', infoHash, options])\n\"\"\"\nnew=\"\"\"    record.engine.push(['onServerRunningFor', infoHash, options])\n    if (record.subscribeGate) await record.subscribeGate\n\"\"\"\nassert old in s; s=s.replace(old,new)\ns=s.replace(\"\"\"    silent: []\n  }\"\"\",\"\"\"    silent: [],\n    // When set, subscribing waits on it.\n    subscribeGate: null\n  }\"\"\")\ns+=\"\"\"\ntest('poster: a timed-out job releases the hold it took',\n  async function (t) {\n    reset()\n    await generateTorrentPoster(VIDEO_TORRENT, SHORT)\n    const calls = record.engine.map((c) => c[0])\n    t.deepEqual(calls.filter((c) => c !== 'onServerRunningFor'),\n      ['startServer', 'stopServer'], 'one hold taken, one released')\n    t.deepEqual(record.engine[calls.indexOf('stopServer')],\n      ['stopServer', INFO_HASH], 'wt-stop-server names the torrent')\n    t.end()\n  })\n\ntest('poster: a job that gi