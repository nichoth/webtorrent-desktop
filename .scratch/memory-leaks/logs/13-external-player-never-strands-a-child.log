dbox::new(\"probe-answers\");\n+        let candidate = Launch {\n+            program: PathBuf::from(\"node\"),\n+            args: vec![sandbox\n+                .player(\"process.exit(0)\")\n+                .to_string_lossy()\n+                .into_owned()],\n+        };\n+        assert!(answers_version_within(&candidate, Duration::from_secs(5)));\n+    }\n+\n M src-tauri/src/external_player.rs","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HQSRmKvSjgSAgtXsEmX7jq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
