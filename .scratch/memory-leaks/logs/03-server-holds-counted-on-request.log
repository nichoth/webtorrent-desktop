 -1\n  if (i !== -1) list.splice(i, 1)\n  server.destroy()\n}\n\nfunction stopAllServers () {\n  for (const infoHash of [...servers.keys()]) forgetServer(infoHash)\n}\n\n'''\ns=s[:start]+new+s[end:]\nold='''    stalls.forget(infoHash)\n  }\n'''\ns=s.replace(old,'''    stalls.forget(infoHash)\n    forgetServer(infoHash)\n  }\n''',1)\nopen(p,'w').write(s)\nEOF\nnpm run build:node >/dev/null 2>&1 && npx tape test/unit/engine-entry.js test/unit/engine-torrent-close-wiring.js 2>&1 | grep -E \"^(not ok|# )\"","uuid":"391bb83e-78a1-48a8-aaf2-365cfda6956c","session_id":"51376cad-72e5-4753-a12b-f4c0880ced8a"}
