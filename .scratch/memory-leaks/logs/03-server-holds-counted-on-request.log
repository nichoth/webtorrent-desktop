{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UFeRgDkqw7zq995LZoZNUr","type":"tool_result","content":"const test = require('tape')\nconst { spawn } = require('child_process')\nconst fs = require('fs')\nconst os = require('os')\nconst path = require('path')\nconst parseTorrent = require('parse-torrent')\nconst WebSocket = require('ws')\n\n// US-040: the engine as a standalone Node process. This drives\n// `build/engine/index.js` the way `src/main/engine-process.js` will in\n// US-041 -- spawn it with plain `node`, read the port off stdout,\n// connect a WebSocket, and speak `wt-*` -- so what it proves is the\n// acceptance criterion itself and not a rehearsal of it.\n\nconst { decode, encode } = require('../../build/shared/wire')\n\nconst REPO = path.join(__dirname, '..', '..')\nconst ENTRY = path.join(REPO, 'build', 'engine', 'index.js')\nconst ENTRY_SRC = path.join(REPO, 'src', 'engine', 'index.js')\nconst FIXTURE = path.join(REPO, 'static', 'sintel.torrent')\nconst TOKEN = 'test-token-40'\n\ntest('the engine answers wt-start-torrenting under plain node',\n  async function (t) {\n    const expected = parseTorrent(await fs.promises.readFile(FIXTURE))\n    const downloadPath = await fs.promises.mkdtemp(\n      path.join(os.tmpdir(), 'wt-engine-test-')\n    )\n\n    const child = spawn(process.execPath, [ENTRY], {\n      cwd: REPO,\n      // NODE_ENV=test keeps config off the real profile directory.\n      env: {\n        ...process.env,\n        NODE_ENV: 'test',\n        WEBTORRENT_ENGINE_TOKEN: TOKEN\n      },\n      stdio: ['ignore', 'pipe', 'pipe']\n    })\n\n    const stdout = []\n    const stderr = []\n    child.stdout.setEncoding('utf8')\n    child.stderr.setEncoding('utf8')\n    child.stdout.on('data', (chunk) => stdout.push(chunk))\n    child.stderr.on('data', (chunk) => stderr.push(chunk))\n\n    const fail = (message) => {\n      t.fail(message + '\\nstdout:\\n' + stdout.join('') +\n        '\\nstderr:\\n' + stderr.join(''))\n    }\n\n    let client = null\n    try {\n      const port = await waitFor(() => {\n        const lines = stdout.join('').split('\\n')\n          .filter((line) => line.startsWith('WEBTORRENT_ENGINE_PORT='))\n        if (lines.length === 0) return null\n        t.equal(lines.length, 1, 'exactly one port line on stdout')\n        return Number(lines[0].slice('WEBTORRENT_ENGINE_PORT='.length))\n      }, 20000)\n\n      t.ok(Number.isInteger(port) && port > 0,\n        'the port line parses to a port (' + port + ')')\n\n      client = new WebSocket(\n        'ws://127.0.0.1:' + port + '/?token=' + TOKEN\n      )\n      const frames = []\n      client.on('message', (data) => frames.push(decode(data)))\n      await new Promise((resolve, reject) => {\n        client.on('open', resolve)\n        client.on('error', reject)\n      })\n      t.pass('the engine accepted a WebSocket connection')\n\n      // Every file deselected: this test is about the protocol, not\n      // about moving 1.1 GB of Sintel onto the disk.\n      const selections = new Array(expected.files.length).fill(false)\n      client.send(encode('wt-start-torrenting',\n        [1, FIXTURE, downloadPath, null, selections]))\n\n      const parsed = await waitFor(\n        () => frames.find((f) => f.channel === 'wt-parsed'), 20000)\n      t.equal(parsed.args[0], 1, 'wt-parsed echoes the torrentKey')\n      t.equal(parsed.args[1], expected.infoHash,\n        'and carries the fixture infoHash')\n\n      const ready = await waitFor(\n        () => frames.find((f) => f.channel === 'wt-ready'), 20000)\n      t.equal(ready.args[0], 1, 'wt-ready echoes the torrentKey')\n      t.equal(ready.args[1].name, expected.name,\n        'the torrent metadata came from the fixture')\n      t.equal(ready.args[1].files.length, expected.files.length,\n        'every file is described')\n\n      const progress = await waitFor(\n        () => frames.find((f) => f.channel === 'wt-progress'), 20000)\n      t.equal(progress.args[0].torrents.length, 1,\n        'wt-progress reports the one torrent')\n\n      client.send(encode('wt-stop-torrenting', [expected.infoHash]))\n    } catch (err) {\n      fail(err.message)\n    } finally {\n      if (client) client.close()\n      child.kill()\n      await new Promise((resolve) => child.on('exit', resolve))\n      await fs.promises.rm(downloadPath, { recursive: true, force: true })\n    }\n\n    t.end()\n  })\n\n// The Tauri host stops the engine by closing its stdin. A pipe emits\n// both `end` and `close`, and with a torrent loaded the client is still\n// being destroyed when the second one arrives -- which must not shut\n// down a second time.\ntest('closing the parent pipe shuts the engine down once',\n  async function (t) {\n    const expected = parseTorrent(await fs.promises.readFile(FIXTURE))\n    const downloadPath = await fs.promises.mkdtemp(\n      path.join(os.tmpdir(), 'wt-engine-test-')\n    )\n\n    const child = spawn(process.execPath, [ENTRY], {\n      cwd: REPO,\n      env: {\n        ...process.env,\n        NODE_ENV: 'test',\n        WEBTORRENT_ENGINE_TOKEN: TOKEN,\n        WEBTORRENT_ENGINE_PARENT_PIPE: '1'\n      },\n      stdio: ['pipe', 'pipe', 'pipe']\n    })\n\n    const stdout = []\n    const stderr = []\n    child.stdout.setEncoding('utf8')\n    child.stderr.setEncoding('utf8')\n    child.stdout.on('data', (chunk) => stdout.push(chunk))\n    child.stderr.on('data', (chunk) => stderr.push(chunk))\n    const exited = new Promise((resolve) => child.on('exit', resolve))\n\n    let client = null\n    try {\n      const port = await waitFor(() => {\n        const line = stdout.join('').split('\\n')\n          .find((l) => l.startsWith('WEBTORRENT_ENGINE_PORT='))\n        return line && Number(line.slice('WEBTORRENT_ENGINE_PORT='.length))\n      }, 20000)\n\n      client = new WebSocket(\n        'ws://127.0.0.1:' + port + '/?token=' + TOKEN\n      )\n      const frames = []\n      client.on('message', (data) => frames.push(decode(data)))\n      client.on('error', () => {})\n      await new Promise((resolve, reject) => {\n        client.on('open', resolve)\n        client.on('error', reject)\n      })\n\n      const selections = new Array(expected.files.length).fill(false)\n      client.send(encode('wt-start-torrenting',\n        [1, FIXTURE, downloadPath, null, selections]))\n      await waitFor(\n        () => frames.find((f) => f.channel === 'wt-ready'), 20000)\n\n      child.stdin.end()\n      const code = await exited\n\n      t.equal(code, 0, 'the engine exits cleanly')\n      t.deepEqual(\n        frames.filter((f) => f.channel === 'wt-uncaught-error'), [],\n        'shutting down raised no uncaught error\\nstderr:\\n' +\n          stderr.join('')\n      )\n    } catch (err) {\n      t.fail(err.message + '\\nstderr:\\n' + stderr.join(''))\n      child.kill()\n      await exited\n    } finally {\n      if (client) client.close()\n      await fs.promises.rm(downloadPath, { recursive: true, force: true })\n    }\n\n    t.end()\n  })\n\ntest('the engine entry point names no host or browser API', function (t) {\n  const source = fs.readFileSync(ENTRY_SRC, 'utf8')\n  // Comments discuss the window the engine is moving out of, so they are\n  // not code and are not scanned.\n  const lines = source.split('\\n')\n    .map((line, i) => ({ line, n: i + 1 }))\n    .filter(({ line }) => !/^\\s*(\\/\\/|\\*|\\/\\*)/.test(line))\n\n  const hits = (re) => lines\n    .filter(({ line }) => re.test(line))\n    .map(({ line, n }) => n + ': ' + line.trim())\n\n  t.deepEqual(hits(/['\"]electron['\"]|\\bipcRenderer\\b/), [],\n    'no Electron module and no ipcRenderer')\n  t.deepEqual(hits(/\\bwindow\\.|\\bdocument\\.|\\bnavigator\\./), [],\n    'no browser-only global')\n  t.deepEqual(hits(/\\.send\\s*\\(/).filter((h) => !/\\bbus\\.send\\(/.test(h)), [],\n    'every send goes through the bus')\n  // Inherited from the deleted `engine-bus-electron.js` (US-045): a\n  // subscription to a protocol channel that bypasses the bus would name\n  // the transport, which is what makes the seam substitutable.\n  const subs = hits(/\\bbus\\.on\\s*\\(|\\.on\\s*\\(\\s*['\"]wt-/)\n  t.ok(subs.length > 5, 'found the engine subscriptions')\n  t.deepEqual(subs.filter((h) => !/\\bbus\\.on\\s*\\(/.test(h)), [],\n    'every subscription goes through the bus')\n  t.equal(hits(/createWebSocketBus\\s*\\(/).length, 1,\n    'the bus is constructed in exactly one place')\n  t.ok(/wt-uncaught-error/.test(source) && /\\bprocess\\.on\\(/.test(source),\n    'uncaught errors are reported from a process handler')\n  t.end()\n})\n\ntest('config paths resolve with no electron module available',\n  function (t) {\n    // The packaged sidecar runs without `node_modules/electron`, so\n    // requiring config must not depend on it resolving. Proved in a\n    // child process: patching module resolution in this one would leak\n    // into every other test file (they share a process).\n    const configPath = path.join(REPO, 'build', 'config.js')\n    const probe = [\n      'const Module = require(\"module\")',\n      'const resolve = Module._resolveFilename',\n      'Module._resolveFilename = function (request, ...rest) {',\n      '  if (request === \"electron\" || request === \"@electron/remote\") {',\n      '    const err = new Error(\"Cannot find module \" + request)',\n      '    err.code = \"MODULE_NOT_FOUND\"',\n      '    throw err',\n      '  }',\n      '  return resolve.call(this, request, ...rest)',\n      '}',\n      'const config = require(' + JSON.stringify(configPath) + ')',\n      'console.log(JSON.stringify({',\n      '  torrent: config.TORRENT_PATH,',\n      '  poster: config.POSTER_PATH',\n      '}))'\n    ].join('\\n')\n\n    const result = spawnSyncNode(probe)\n    t.equal(result.status, 0,\n      'config loads outside Electron: ' + result.stderr)\n    const paths = JSON.parse(result.stdout || '{}')\n    t.ok(path.isAbsolute(paths.torrent || ''),\n      'TORRENT_PATH is absolute: ' + paths.torrent)\n    t.equal(path.basename(paths.torrent || ''), 'Torrents',\n      'and still ends in Torrents')\n    t.ok(path.isAbsolute(paths.poster || ''),\n      'POSTER_PATH is absolute: ' + paths.poster)\n    t.equal(path.basename(paths.poster || ''), 'Posters',\n      'and still ends in Posters')\n    t.end()\n  })\n\nfunction spawnSyncNode (source) {\n  const { spawnSync } = require('child_process')\n  return spawnSync(process.execPath, ['-e', source], {\n    cwd: REPO,\n    encoding: 'utf8'\n  })\n}\n\n// Resolve as soon as `probe` returns something truthy, or reject on\n// timeout. Every wait in this file is for a real event from another\n// process, so there is no fixed delay anywhere.\nfunction waitFor (probe, timeout = 5000) {\n  return new Promise((resolve, reject) => {\n    const started = Date.now()\n    const poll = setInterval(() => {\n      let value\n      try {\n        value = probe()\n      } catch (err) {\n        clearInterval(poll)\n        return reject(err)\n      }\n      if (value) {\n        clearInterval(poll)\n        resolve(value)\n      } else if (Date.now() - started > timeout) {\n        clearInterval(poll)\n        reject(new Error('timed out waiting for the engine'))\n      }\n    }, 20)\n  })\n}\nconst test = require('tape')\nconst fs = require('fs')\nconst path = require('path')\n\n// The engine keeps per-torrent diagnostic state -- announce times,\n// corrupt-peer tallies, stall samples -- keyed by info hash. A torrent\n// can close without `wt-stop-torrenting` (a fatal error, say), and\n// state left behind under its info hash greets the torrent when the\n// user resumes it: the stall clock is still running from the old\n// session, so it reports as stalled on its first progress update.\n//\n// That outcome is pinned against plain values by \"a forgotten torrent\n// starts over\" in `engine-stall.js`. What this checks is the wiring:\n// the forgetting hangs off the torrent's own `close`, which WebTorrent\n// emits from `destroy()` whatever the reason, so no close path can skip\n// it. Driving a real stall from a spawned sidecar would take a minute\n// per case, so this is a source scan in the shape of\n// `engine-sweep-wiring.js`.\n\nconst ENTRY_SRC = path.join(\n  __dirname, '..', '..', 'src', 'engine', 'index.js')\n\nconst source = fs.readFileSync(ENTRY_SRC, 'utf8')\n\n// Every assertion below asserts PRESENCE, so comments are stripped\n// whole first, for the reason spelled out in `engine-sweep-wiring.js`.\nconst code = source\n  .replace(/\\/\\*[\\s\\S]*?\\*\\//g, '')\n  .split('\\n')\n  .filter((line) => !/^\\s*\\/\\//.test(line))\n  .join('\\n')\n\nconst wiring = /function addTorrentEvents \\(torrent\\) \\{[\\s\\S]*?\\n\\}/\n  .exec(code)\nconst events = wiring ? wiring[0] : ''\n\ntest('a closing torrent is handled where its events are wired',\n  function (t) {\n    t.ok(wiring, 'addTorrentEvents is found')\n    t.ok(/torrent\\.once?\\('close',\\s*torrentClose\\)/.test(events),\n      'the torrent\\'s own close event has a handler')\n    t.equal((code.match(/\\.once?\\('close',\\s*torrentClose\\)/g) || [])\n      .length, 1, 'and there is exactly one, so cleanup has one home')\n    t.end()\n  })\n\ntest('the close handler forgets every kind of per-torrent state',\n  function (t) {\n    const handler = /function torrentClose \\(\\) \\{[\\s\\S]*?\\n {2}\\}/\n      .exec(events)\n    t.ok(handler, 'torrentClose is found inside addTorrentEvents')\n    const body = handler ? handler[0] : ''\n\n    t.ok(/const infoHash = torrent\\.infoHash/.test(body),\n      'it reads the closing torrent\\'s own info hash')\n    t.ok(/lastAnnounceAt\\.delete\\(infoHash\\)/.test(body),\n      'the announce time is forgotten')\n    t.ok(/corruptPeerStats\\.delete\\(infoHash\\)/.test(body),\n      'the corrupt-peer tally is forgotten')\n    t.ok(/stalls\\.forget\\(infoHash\\)/.test(body),\n      'and the stall samples are forgotten, so a resumed torrent ' +\n      'starts with a clean stall clock')\n\n    // WebTorrent destroys a duplicate add after giving it the live\n    // torrent's info hash, and removes a closing torrent from the\n    // client before emitting `close`. So a torrent still found under\n    // the hash at close time is someone else's, and its state stays.\n    const guardAt = body.search(/if \\(client\\.get\\(infoHash\\)\\) return/)\n    const forgetAt = body.search(/lastAnnounceAt\\.delete/)\n    t.ok(guardAt >= 0 && guardAt < forgetAt,\n      'a duplicate closing does not wipe the live torrent\\'s state')\n    t.end()\n  })\n\ntest('stop-torrenting relies on the close handler', function (t) {\n  const stop = /function stopTorrenting \\(infoHash\\) \\{[\\s\\S]*?\\n\\}/\n    .exec(code)\n  t.ok(stop, 'stopTorrenting is found')\n  const body = stop ? stop[0] : ''\n  t.ok(/torrent\\.destroy\\(\\)/.test(body),\n    'it destroys the torrent, which emits close')\n  t.notOk(/lastAnnounceAt\\.delete|corruptPeerStats\\.delete|stalls\\.forget/\n    .test(body), 'and does not keep a second copy of the cleanup')\n  t.end()\n})","is_error":false}]},"parent_tool_use_id":null,"session_id":"51376cad-72e5-4753-a12b-f4c0880ced8a","uuid":"dc4716a0-29c1-4dda-b08e-3e7dc15b3799","timestamp":"2026-10-18T01:20:17.048Z","tool_use_result":{"stdout":"const test = require('tape')\nconst { spawn } = require('child_process')\nconst fs = require('fs')\nconst os = require('os')\nconst path = require('path')\nconst parseTorrent = require('parse-torrent')\nconst WebSocket = require('ws')\n\n// US-040: the engine as a standalone Node process. This drives\n// `build/engine/index.js` the way `src/main/engine-process.js` will in\n// US-041 -- spawn it with plain `node`, read the port off stdout,\n// connect a WebSocket, and speak `wt-*` -- so what it proves is the\n// acceptance criterion itself and not a rehearsal of it.\n\nconst { decode, encode } = require('../../build/shared/wire')\n\nconst REPO = path.join(__dirname, '..', '..')\nconst ENTRY = path.join(REPO, 'build', 'engine', 'index.js')\nconst ENTRY_SRC = path.join(REPO, 'src', 'engine', 'index.js')\nconst FIXTURE = path.join(REPO, 'static', 'sintel.torrent')\nconst TOKEN = 'test-token-40'\n\ntest('the engine answers wt-start-torrenting under plain node',\n  async function (t) {\n    const expected = parseTorrent(await fs.promises.readFile(FIXTURE))\n    const downloadPath = await fs.promises.mkdtemp(\n      path.join(os.tmpdir(), 'wt-engine-test-')\n    )\n\n    const child = spawn(process.execPath, [ENTRY], {\n      cwd: REPO,\n      // NODE_ENV=test keeps config off the real profile directory.\n      env: {\n        ...process.env,\n        NODE_ENV: 'test',\n        WEBTORRENT_ENGINE_TOKEN: TOKEN\n      },\n      stdio: ['ignore', 'pipe', 'pipe']\n    })\n\n    const stdout = []\n    const stderr = []\n    child.stdout.setEncoding('utf8')\n    child.stderr.setEncoding('utf8')\n    child.stdout.on('data', (chunk) => stdout.push(chunk))\n    child.stderr.on('data', (chunk) => stderr.push(chunk))\n\n    const fail = (message) => {\n      t.fail(message + '\\nstdout:\\n' + stdout.join('') +\n        '\\nstderr:\\n' + stderr.join(''))\n    }\n\n    let client = null\n    try {\n      const port = await waitFor(() => {\n        const lines = stdout.join('').split('\\n')\n          .filter((line) => line.startsWith('WEBTORRENT_ENGINE_PORT='))\n        if (lines.length === 0) return null\n        t.equal(lines.length, 1, 'exactly one port line on stdout')\n        return Number(lines[0].slice('WEBTORRENT_ENGINE_PORT='.length))\n      }, 20000)\n\n      t.ok(Number.isInteger(port) && port > 0,\n        'the port line parses to a port (' + port + ')')\n\n      client = new WebSocket(\n        'ws://127.0.0.1:' + port + '/?token=' + TOKEN\n      )\n      const frames = []\n      client.on('message', (data) => frames.push(decode(data)))\n      await new Promise((resolve, reject) => {\n        client.on('open', resolve)\n        client.on('error', reject)\n      })\n      t.pass('the engine accepted a WebSocket connection')\n\n      // Every file deselected: this test is about the protocol, not\n      // about moving 1.1 GB of Sintel onto the disk.\n      const selections = new Array(expected.files.length).fill(false)\n      client.send(encode('wt-start-torrenting',\n        [1, FIXTURE, downloadPath, null, selections]))\n\n      const parsed = await waitFor(\n        () => frames.find((f) => f.channel === 'wt-parsed'), 20000)\n      t.equal(parsed.args[0], 1, 'wt-parsed echoes the torrentKey')\n      t.equal(parsed.args[1], expected.infoHash,\n        'and carries the fixture infoHash')\n\n      const ready = await waitFor(\n        () => frames.find((f) => f.channel === 'wt-ready'), 20000)\n      t.equal(ready.args[0], 1, 'wt-ready echoes the torrentKey')\n      t.equal(ready.args[1].name, expected.name,\n        'the torrent metadata came from the fixture')\n      t.equal(ready.args[1].files.length, expected.files.length,\n        'every file is described')\n\n      const progress = await waitFor(\n        () => frames.find((f) => f.channel === 'wt-progress'), 20000)\n      t.equal(progress.args[0].torrents.length, 1,\n        'wt-progress reports the one torrent')\n\n      client.send(encode('wt-stop-torrenting', [expected.infoHash]))\n    } catch (err) {\n      fail(err.message)\n    } finally {\n      if (client) client.close()\n      child.kill()\n      await new Promise((resolve) => child.on('exit', resolve))\n      await fs.promises.rm(downloadPath, { recursive: true, force: true })\n    }\n\n    t.end()\n  })\n\n// The Tauri host stops the engine by closing its stdin. A pipe emits\n// both `end` and `close`, and with a torrent loaded the client is still\n// being destroyed when the second one arrives -- which must not shut\n// down a second time.\ntest('closing the parent pipe shuts the engine down once',\n  async function (t) {\n    const expected = parseTorrent(await fs.promises.readFile(FIXTURE))\n    const downloadPath = await fs.promises.mkdtemp(\n      path.join(os.tmpdir(), 'wt-engine-test-')\n    )\n\n    const child = spawn(process.execPath, [ENTRY], {\n      cwd: REPO,\n      env: {\n        ...process.env,\n        NODE_ENV: 'test',\n        WEBTORRENT_ENGINE_TOKEN: TOKEN,\n        WEBTORRENT_ENGINE_PARENT_PIPE: '1'\n      },\n      stdio: ['pipe', 'pipe', 'pipe']\n    })\n\n    const stdout = []\n    const stderr = []\n    child.stdout.setEncoding('utf8')\n    child.stderr.setEncoding('utf8')\n    child.stdout.on('data', (chunk) => stdout.push(chunk))\n    child.stderr.on('data', (chunk) => stderr.push(chunk))\n    const exited = new Promise((resolve) => child.on('exit', resolve))\n\n    let client = null\n    try {\n      const port = await waitFor(() => {\n        const line = stdout.join('').split('\\n')\n          .find((l) => l.startsWith('WEBTORRENT_ENGINE_PORT='))\n        return line && Number(line.slice('WEBTORRENT_ENGINE_PORT='.length))\n      }, 20000)\n\n      client = new WebSocket(\n        'ws://127.0.0.1:' + port + '/?token=' + TOKEN\n      )\n      const frames = []\n      client.on('message', (data) => frames.push(decode(data)))\n      client.on('error', () => {})\n      await new Promise((resolve, reject) => {\n        client.on('open', resolve)\n        client.on('error', reject)\n      })\n\n      const selections = new Array(expected.files.length).fill(false)\n      client.send(encode('wt-start-torrenting',\n        [1, FIXTURE, downloadPath, null, selections]))\n      await waitFor(\n        () => frames.find((f) => f.channel === 'wt-ready'), 20000)\n\n      child.stdin.end()\n      const code = await exited\n\n      t.equal(code, 0, 'the engine exits cleanly')\n      t.deepEqual(\n        frames.filter((f) => f.channel === 'wt-uncaught-error'), [],\n        'shutting down raised no uncaught error\\nstderr:\\n' +\n          stderr.join('')\n      )\n    } catch (err) {\n      t.fail(err.message + '\\nstderr:\\n' + stderr.join(''))\n      child.kill()\n      await exited\n    } finally {\n      if (client) client.close()\n      await fs.promises.rm(downloadPath, { recursive: true, force: true })\n    }\n\n    t.end()\n  })\n\ntest('the engine entry point names no host or browser API', function (t) {\n  const source = fs.readFileSync(ENTRY_SRC, 'utf8')\n  // Comments discuss the window the engine is moving out of, so they are\n  // not code and are not scanned.\n  const lines = source.split('\\n')\n    .map((line, i) => ({ line, n: i + 1 }))\n    .filter(({ line }) => !/^\\s*(\\/\\/|\\*|\\/\\*)/.test(line))\n\n  const hits = (re) => lines\n    .filter(({ line }) => re.test(line))\n    .map(({ line, n }) => n + ': ' + line.trim())\n\n  t.deepEqual(hits(/['\"]electron['\"]|\\bipcRenderer\\b/), [],\n    'no Electron module and no ipcRenderer')\n  t.deepEqual(hits(/\\bwindow\\.|\\bdocument\\.|\\bnavigator\\./), [],\n    'no browser-only global')\n  t.deepEqual(hits(/\\.send\\s*\\(/).filter((h) => !/\\bbus\\.send\\(/.test(h)), [],\n    'every send goes through the bus')\n  // Inherited from the deleted `engine-bus-electron.js` (US-045): a\n  // subscription to a protocol channel that bypasses the bus would name\n  // the transport, which is what makes the seam substitutable.\n  const subs = hits(/\\bbus\\.on\\s*\\(|\\.on\\s*\\(\\s*['\"]wt-/)\n  t.ok(subs.length > 5, 'found the engine subscriptions')\n  t.deepEqual(subs.filter((h) => !/\\bbus\\.on\\s*\\(/.test(h)), [],\n    'every subscription goes through the bus')\n  t.equal(hits(/createWebSocketBus\\s*\\(/).length, 1,\n    'the bus is constructed in exactly one place')\n  t.ok(/wt-uncaught-error/.test(source) && /\\bprocess\\.on\\(/.test(source),\n    'uncaught errors are reported from a process handler')\n  t.end()\n})\n\ntest('config paths resolve with no electron module available',\n  function (t) {\n    // The packaged sidecar runs without `node_modules/electron`, so\n    // requiring config must not depend on it resolving. Proved in a\n    // child process: patching module resolution in thi