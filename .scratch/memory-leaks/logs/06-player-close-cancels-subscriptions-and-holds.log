   t.deepEqual(record.listeners[0].args, ['abc', { once: true }],\n      'addressed by info hash, one-shot')\n\n    record.listeners[0].listener('k', {})\n    await flush()\n    t.deepEqual(record.engine, [['startServer', 'abc']],\n      'the ready event starts the server')\n    t.end()\n  })\n\ntest('closing the player stops the server through the shim',\n  async function (t) {\n    reset()\n    const state = {\n      playing: { location: 'local', volume: 1, infoHash: 'abc' },\n      window: { isFullScreen: false, bounds: null },\n      saved: { prefs: {} }\n    }\n    new PlaybackController(state, {}, () => {}).closePlayer()\n    await flush()\n    t.deepEqual(record.engine, [['stopServer', 'abc']],\n      'the server is released by info hash')\n    t.end()\n  })\n\ntest('closing the player ends the external player\\'s server wait',\n  function (t) {\n    reset()\n    const state = {\n      playing: { location: 'external', volume: 1, infoHash: 'abc' },\n      window: { isFullScreen: false, bounds: null },\n      saved: { prefs: {} }\n    }\n    new PlaybackController(state, {}, () => {}).closePlayer()\n    t.deepEqual(record.dispatches.filter((d) => d[0] === 'playerClosed'),\n      [['playerClosed']], 'the media controller is told')\n    t.end()\n  })\n\n// -- media-controller ------------------------------------------------\n\ntest('with no server yet, the external player waits through the shim',\n  async function (t) {\n    reset()\n    const state = {\n      playing: { fileIndex: 0, fileName: 'x.mp4', infoHash: 'abc' },\n      server: null,\n      window: { title: 'T' },\n      saved: { prefs: { externalPlayerPath: '' } }\n    }\n    new MediaController(state).openExternalPlayer()\n    await flush()\n    t.equal(record.listeners.length, 1, 'one listener was registered')\n    t.equal(record.listeners[0].name, 'onServerRunningFor',\n      'on the engine shim, not ipcRenderer')\n    t.deepEqual(record.listeners[0].args, ['abc', { once: true }],\n      'addressed b