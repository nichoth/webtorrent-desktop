{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015USnye5TLb2hcXFkqgBBHG","type":"tool_result","content":"diff --git a/src/engine/audio-metadata.js b/src/engine/audio-metadata.js\nnew file mode 100644\nindex 0000000..99bdf01\n--- /dev/null\n+++ b/src/engine/audio-metadata.js\n@@ -0,0 +1,27 @@\n+// Audio metadata for one torrent file, read without leaking a stream.\n+//\n+// A file that is still downloading is parsed from a torrent read\n+// stream. Each such stream keeps up to a piece buffer and a\n+// high-priority selection until it is destroyed -- and that selection\n+// keeps the file downloading after the user deselects it. music-metadata\n+// stops reading once it has what it needs but never destroys the stream\n+// it was handed, so this module owns the stream and destroys it once\n+// the parse settles, whether it resolved or rejected.\n+//\n+// A finished file is parsed from disk by path; music-metadata opens and\n+// closes that file itself.\n+\n+import path from 'path'\n+import mm from 'music-metadata'\n+\n+// `parser` defaults to music-metadata and is a parameter so the stream\n+// handling can be tested without real audio.\n+export function readAudioMetadata (file, torrentPath, options, parser = mm) {\n+  if (file.done) {\n+    return parser.parseFile(path.join(torrentPath, file.path), options)\n+  }\n+\n+  const stream = file.createReadStream()\n+  return parser.parseStream(stream, file.name, options)\n+    .finally(() => stream.destroy())\n+}\ndiff --git a/src/engine/index.js b/src/engine/index.js\nindex a3e6b99..e3ed316 100644\n--- a/src/engine/index.js\n+++ b/src/engine/index.js\n@@ -25,18 +25,19 @@ import crypto from 'crypto'\n import fs from 'fs'\n import path from 'path'\n import util from 'util'\n-import mm from 'music-metadata'\n import networkAddress from 'network-address'\n import WebTorrent from 'webtorrent'\n \n import config from '../config'\n import { runAnnounceSweep, SWEEP_INTERVAL_MS } from './announce'\n+import { readAudioMetadata } from './audio-metadata'\n import { createWebSocketBus } from './bus-websocket'\n import { limitPendingDials } from './dials'\n import {\n   bannedSinceProgress, createHashFailTracker, guardIncomingPeers,\n   guardPeerAdds, parseFailedPiece\n } from './hashfail'\n+import { diffSelections } from './selections'\n import { createStallTracker, verifiedBytes } from './stall'\n \n console.time('init')\n@@ -113,6 +114,13 @@ const corruptPeerStats = new Map()\n // `downloaded` counts piece buffers that may still fail their hash.\n const stalls = createStallTracker()\n \n+// Info hash -> the file selections last applied to that torrent. Each\n+// `file.select()` adds a selection webtorrent keeps until one\n+// `file.deselect()` removes it, so only what changed is applied\n+// (`selections.js`). Forgotten when the torrent closes, so a resumed\n+// torrent starts from webtorrent's default selection again.\n+const appliedSelections = new Map()\n+\n // The one hook WebTorrent 1.9.7 offers for refusing a peer. It is\n // documented as a static IP blocklist loaded at construction, but\n // `Torrent#addPeer` only ever asks `client.blocked.contains(host)`, so\n@@ -237,9 +245,8 @@ function startTorrenting (torrentKey, torrentID, path, fileModtimes, selections)\n \n function stopTorrenting (infoHash) {\n   console.log('--- STOP TORRENTING: ', infoHash)\n-  lastAnnounceAt.delete(infoHash)\n-  corruptPeerStats.delete(infoHash)\n-  stalls.forget(infoHash)\n+  // The per-torrent state goes in `torrentClose`, which `destroy()`\n+  // triggers, so this path and a fatal error share one cleanup.\n   const torrent = client.get(infoHash)\n   if (torrent) torrent.destroy()\n }\n@@ -327,6 +334,29 @@ function addTorrentEvents (torrent) {\n   torrent.on('metadata', torrentMetadata)\n   torrent.on('ready', torrentReady)\n   torrent.on('done', torrentDone)\n+  torrent.once('close', torrentClose)\n+\n+  // The single place a closing torrent is forgotten. WebTorrent emits\n+  // 