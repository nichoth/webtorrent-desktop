{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QFLZHRwkwTsbHxemSY4bxr","type":"tool_result","content":"diff --git a/src/renderer/controllers/AGENTS.md b/src/renderer/controllers/AGENTS.md\nindex a95d838..d8d3029 100644\n--- a/src/renderer/controllers/AGENTS.md\n+++ b/src/renderer/controllers/AGENTS.md\n@@ -69,6 +69,22 @@ name: call `ipcEngine.onTorrentReadyFor(infoHash, listener, { once:\n true })` rather than building `'wt-ready-' + infoHash`. A one-shot\n listener is `{ once: true }`, not a separate export.\n \n+Subscriptions resolve to their unsubscribe function, so a wait that\n+has to be cancelled (on leaving the player, say) must cope with the\n+cancel arriving before that promise does: record that it was\n+cancelled and call the unsubscribe as soon as it arrives. The listener\n+should also check that the thing it was armed for is still current\n+(`state.playing` is replaced on close), because a delivery can race\n+the withdrawal. `openExternalPlayer` in `media-controller.js` is the\n+worked example. `playback-controller.js` keeps every wait a play makes\n+through `keepSubscription()`, and `closePlayer` withdraws them all; a\n+new one-shot subscription for a play goes through it too.\n+\n+`wt-stop-server` releases one holder of a torrent's server (ADR-013),\n+so send it only for a `wt-start-server` this caller actually sent --\n+`playback-controller.js` records that in `serverInfoHash`. An\n+unmatched stop releases another caller's hold, a poster job's say.\n+\n **Every shim call is async, and `dispatch()` re-renders synchronously.**\n `dispatch(action)` calls the handler and then `update()` in the same\n turn, so any state a controller writes inside a `.then()` lands *after*\n@@ -79,3 +95,9 @@ something else, which re-renders on its own. And always terminate the\n promise. For fire-and-forget calls that is `reportErrors(...)` from\n `lib/dispatcher`, which is `.catch(err => dispatch('error', err))` in\n one call; a floating rejection is invisible.\n+\n+**Record user-facing errors with `recordError` from\n+`lib/error-list.js`**, never `state.errors.push(...)`. It drops errors\n+older than the banner window (`ERROR_WINDOW_MS`, which `pages/app.js`\n+uses to filter) so the list stays bounded. `test/unit/error-list.js`\n+scans `src/renderer/` and fails on a direct push.\ndiff --git a/src/renderer/controllers/cast-controller.js b/src/renderer/controllers/cast-controller.js\nindex e4d7dc7..6f9cb3a 100644\n--- a/src/renderer/controllers/cast-controller.js\n+++ b/src/renderer/controllers/cast-controller.js\n@@ -2,6 +2,7 @@ import * as cast from '../lib/platform/cast'\n import * as CastMirror from '../lib/cast-mirror'\n import { reportErrors } from '../lib/dispatcher'\n import { CastingError } from '../lib/errors'\n+import { recordError } from '../lib/error-list'\n \n // Controls remote playback on Chromecast, DLNA and AirPlay receivers.\n //\n@@ -149,11 +150,11 @@ export default class CastController {\n   }\n \n   // Casting failed, at any point: discovery, connecting, or a session\n-  // that dropped. Pushed onto `state.errors` the way the old module\n+  // that dropped. Recorded in `state.errors` the way the old module\n   // did rather than dispatched as an error, so it stays a message in\n   // the corner and not an error sound.\n   raise (message) {\n-    this.state.errors.push({ time: new Date().getTime(), message })\n+    recordError(this.state.errors, message)\n     this.update()\n   }\n }\ndiff --git a/src/renderer/controllers/media-controller.js b/src/renderer/controllers/media-controller.js\nindex dd24b31..aab1496 100644\n--- a/src/renderer/controllers/media-controller.js\n+++ b/src/renderer/controllers/media-controller.js\n@@ -9,6 +9,8 @@ import { unsupportedMediaMessage } from '../lib/media-playability'\n export default class MediaController {\n   constructor (state) {\n     this.state = state\n+    // Withdraws the external player's \"server running\" wait, if any\n+    this.cancelServerWait = noop\n   }\n \n   // Dispatched by the <video>/<audio> tag; nothing to do, but the dispatcher\n@@ -73,10 +75,14 @@ export default class MediaController {\n \n   openExternalPlayer () {\n     const state = this.state\n-    state.playing.location = 'external'\n+    const playing = state.playing\n+    playing.location = 'external'\n \n     const onServerRunning = () => {\n-      state.playing.isReady = true\n+      // The user may have left the player while the server was coming\n+      // up; that play is over, and its URL with it.\n+      if (state.playing !== playing) return\n+      playing.isReady = true\n \n       const mediaURL = Playlist.getCurrentLocalURL(state)\n       reportErrors(ipcOs.openExternalPlayer(\n@@ -85,13 +91,30 @@ export default class MediaController {\n         state.window.title))\n     }\n \n-    if (state.server != null) onServerRunning()\n-    else {\n-      // Addressed by info hash: since ADR-013 the broadcast channel can\n-      // carry a server started for poster generation.\n-      reportErrors(ipcEngine.onServerRunningFor(\n-        state.playing.infoHash, onServerRunning, { once: true }))\n+    if (state.server != null) return onServerRunning()\n+\n+    // Addressed by info hash: since ADR-013 the broadcast channel can\n+    // carry a server started for poster generation.\n+    this.cancelServerWait()\n+    let cancelled = false\n+    let unsubscribe = null\n+    this.cancelServerWait = () => {\n+      cancelled = true\n+      if (unsubscribe) unsubscribe()\n+      this.cancelServerWait = noop\n     }\n+    reportErrors(ipcEngine.onServerRunningFor(\n+      playing.infoHash, onServerRunning, { once: true }\n+    ).then((unsub) => {\n+      // Leaving before the shim answered: withdraw it now.\n+      if (cancelled) unsub()\n+      else unsubscribe = unsub\n+    }))\n+  }\n+\n+  // Dispatched by the playback controller as the player closes.\n+  playerClosed () {\n+    this.cancelServerWait()\n   }\n \n   externalPlayerNotFound () {\n@@ -101,3 +124,5 @@ export default class MediaController {\n     }\n   }\n }\n+\n+function noop () {}\ndiff --git a/src/renderer/controllers/playback-controller.js b/src/renderer/controllers/playback-controller.js\nindex a577ea0..4bd2b92 100644\n--- a/src/renderer/controllers/playback-controller.js\n+++ b/src/renderer/controllers/playback-controller.js\n@@ -20,6 +20,10 @@ export default class PlaybackController {\n     this.state = state\n     this.config = config\n     this.update = update\n+    // Withdraws each engine subscription made for the current play.\n+    this.subscriptions = []\n+    // The info hash whose server this play asked for, if it did.\n+    this.serverInfoHash = null\n   }\n \n   // Play a file in a torrent.\n@@ -261,25 +265,48 @@ export default class PlaybackController {\n   // Starts WebTorrent server for media streaming\n   startServer (torrentSummary) {\n     const state = this.state\n+    // `closePlayer` replaces `state.playing`, so a delivery that races\n+    // the close finds a different object and leaves it alone.\n+    const playing = state.playing\n \n-    if (torrentSummary.status === 'paused') {\n-      dispatch('startTorrentingSummary', torrentSummary.torrentKey)\n-      reportErrors(ipcEngine.onTorrentReadyFor(\n-        torrentSummary.infoHash, () => onTorrentReady(), { once: true }))\n-    } else {\n-      onTorrentReady()\n-    }\n-\n-    function onTorrentReady () {\n+    const onTorrentReady = () => {\n+      if (state.playing !== playing) return\n       // Addressed by info hash: since ADR-013 poster generation starts\n       // servers too, so the broadcast channel can carry a server for a\n       // torrent the user is not watching.\n-      reportErrors(ipcEngine.onServerRunningFor(\n+      this.keepSubscription(ipcEngine.onServerRunningFor(\n         torrentSummary.infoHash,\n-        () => { state.playing.isReady = true },\n+        () => {\n+          if (state.playing === playing) playing.isReady = true\n+   