{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017kYXKicVKuytNkHMLmtMHS","type":"tool_result","content":"1\timport path from 'path'\n2\t\n3\timport { canSetRate } from '../lib/cast-mirror'\n4\timport { dispatch, reportErrors } from '../lib/dispatcher'\n5\timport { UnplayableFileError, UnplayableTorrentError } from '../lib/errors'\n6\timport * as sound from '../lib/sound'\n7\timport * as TorrentPlayer from '../lib/torrent-player'\n8\timport * as TorrentSummary from '../lib/torrent-summary'\n9\timport * as cast from '../lib/platform/cast'\n10\timport * as ipcEngine from '../lib/platform/ipc-engine'\n11\timport * as ipcOs from '../lib/platform/ipc-os'\n12\timport * as shell from '../lib/platform/shell'\n13\timport * as Playlist from '../lib/playlist'\n14\timport State from '../lib/state'\n15\t\n16\t// Controls playback of torrents and files within torrents\n17\t// both local (<video>,<audio>,external player) and remote (cast)\n18\texport default class PlaybackController {\n19\t  constructor (state, config, update) {\n20\t    this.state = state\n21\t    this.config = config\n22\t    this.update = update\n23\t    // Withdraws each engine subscription made for the current play.\n24\t    this.subscriptions = []\n25\t    // The info hash whose server this play asked for, if it did.\n26\t    this.serverInfoHash = null\n27\t  }\n28\t\n29\t  // Play a file in a torrent.\n30\t  // * Start torrenting, if necessary\n31\t  // * Stream, if not already fully downloaded\n32\t  // * If no file index is provided, restore the most recently viewed file or autoplay the first\n33\t  playFile (infoHash, index /* optional */) {\n34\t    this.pauseActiveTorrents(infoHash)\n35\t\n36\t    const state = this.state\n37\t    if (state.location.url() === 'player') {\n38\t      this.updatePlayer(infoHash, index, false, (err) => {\n39\t        if (err) return dispatch('error', err)\n40\t        this.play()\n41\t        dispatch('checkMediaPlayability')\n42\t      })\n43\t    } else {\n44\t      let initialized = false\n45\t      state.location.go({\n46\t        url: 'player',\n47\t        setup: (cb) => {\n48\t          const torrentSummary = TorrentSummary.getByKey(state, infoHash)\n49\t\n50\t          if (index === undefined || initialized) index = torrentSummary.mostRecentFileIndex\n51\t          if (index === undefined) index = torrentSummary.files.findIndex(TorrentPlayer.isPlayable)\n52\t          if (index === undefined) return cb(new UnplayableTorrentError())\n53\t\n54\t          initialized = true\n55\t\n56\t          this.openPlayer(infoHash, index, (err) => {\n57\t            if (!err) this.play()\n58\t            cb(err)\n59\t          })\n60\t        },\n61\t        destroy: () => this.closePlayer()\n62\t      }, (err) => {\n63\t        if (err) return dispatch('error', err)\n64\t        // Not from inside `setup`: `location-history` sets the current\n65\t        // page only once setup has called back, and the modal is\n66\t        // opened by `mediaError`, which ignores anything dispatched\n67\t        // while the location is still the torrent list.\n68\t        dispatch('checkMediaPlayability')\n69\t      })\n70\t    }\n71\t  }\n72\t\n73\t  // Open a file in OS default app.\n74\t  openPath (infoHash, index) {\n75\t    const torrentSummary = TorrentSummary.getByKey(this.state, infoHash)\n76\t    const filePath = path.join(\n77\t      torrentSummary.path,\n78\t      torrentSummary.files[index].path)\n79\t    reportErrors(shell.openPath(filePath))\n80\t  }\n81\t\n82\t  // Toggle (play or pause) the currently playing media\n83\t  playPause () {\n84\t    const state = this.state\n85\t    if (state.location.url() !== 'player') return\n86\t\n87\t    // force rerendering if window is hidden,\n88\t    // in order to bypass `raf` and play/pause media immediately\n89\t    const mediaTag = document.querySelector('video,audio')\n90\t    if (!state.window.isVisible && mediaTag) {\n91\t      if (state.playing.isPaused) mediaTag.play()\n92\t      else mediaTag.pause()\n93\t    }\n94\t\n95\t    if (state.playing.isPaused) this.play()\n96\t    else this.pause()\n97\t  }\n98\t\n99\t  pauseActiveTorrents (infoHash) {\n100\t    // Playback Priority: pause all active torrents if needed.\n101\t    if (!this.state.saved.prefs.highestPlaybackPriority) return\n102\t\n103\t    // Do not pause active torrents if playing a fully downloaded torrent.\n104\t    const torrentSummary = TorrentSummary.getByKey(this.state, infoHash)\n105\t    if (torrentSummary.status === 'seeding') return\n106\t\n107\t    dispatch('prioritizeTorrent', infoHash)\n108\t  }\n109\t\n110\t  // Play next file in list (if any)\n111\t  nextTrack () {\n112\t    const state = this.state\n113\t    if (Playlist.hasNext(state) && state.playing.location !== 'external') {\n114\t      this.updatePlayer(\n115\t        state.playing.infoHash, Playlist.getNextIndex(state), false, (err) => {\n116\t          if (err) dispatch('error', err)\n117\t          else this.play()\n118\t        })\n119\t    }\n120\t  }\n121\t\n122\t  // Play previous track in list (if any)\n123\t  previousTrack () {\n124\t    const state = this.state\n125\t    if (Playlist.hasPrevious(state) && state.playing.location !== 'external') {\n126\t      this.updatePlayer(\n127\t        state.playing.infoHash, Playlist.getPreviousIndex(state), false, (err) => {\n128\t          if (err) dispatch('error', err)\n129\t          else this.play()\n130\t        })\n131\t    }\n132\t  }\n133\t\n134\t  // Play (unpause) the current media\n135\t  play () {\n136\t    const state = this.state\n137\t    if (!state.playing.isPaused) return\n138\t    state.playing.isPaused = false\n139\t    if (isCasting(state)) {\n140\t      reportErrors(cast.play())\n141\t    }\n142\t    reportErrors(ipcOs.notifyPlayerPlay())\n143\t  }\n144\t\n145\t  // Pause the currently playing media\n146\t  pause () {\n147\t    const state = this.state\n148\t    if (state.playing.isPaused) return\n149\t    state.playing.isPaused = true\n150\t    if (isCasting(state)) {\n151\t      reportErrors(cast.pause())\n152\t    }\n153\t    reportErrors(ipcOs.notifyPlayerPause())\n154\t  }\n155\t\n156\t  // Skip specified number of seconds (backwards if negative)\n157\t  skip (time) {\n158\t    this.skipTo(this.state.playing.currentTime + time)\n159\t  }\n160\t\n161\t  // Skip (aka seek) to a specific point, in seconds\n162\t  skipTo (time) {\n163\t    if (!Number.isFinite(time)) {\n164\t      console.error('Tried to skip to a non-finite time ' + time)\n165\t      return console.trace()\n166\t    }\n167\t    if (isCasting(this.state)) reportErrors(cast.seek(time))\n168\t    else this.state.playing.jumpToTime = time\n169\t  }\n170\t\n171\t  // Show video preview\n172\t  preview (x) {\n173\t    if (!Number.isFinite(x)) {\n174\t      console.error('Tried to preview a non-finite position ' + x)\n175\t      return console.trace()\n176\t    }\n177\t    this.state.playing.previewXCoord = x\n178\t  }\n179\t\n180\t  // Hide video preview\n181\t  clearPreview () {\n182\t    this.state.playing.previewXCoord = null\n183\t  }\n184\t\n185\t  // Change playback speed. 1 = faster, -1 = slower\n186\t  // Playback speed ranges from 16 (fast forward) to 1 (normal playback)\n187\t  // to 0.25 (quarter-speed playback), then goes to -0.25, -0.5, -1, -2, etc\n188\t  // until -16 (fast rewind)\n189\t  changePlaybackRate (direction) {\n190\t    const state = this.state\n191\t    let rate = state.playing.playbackRate\n192\t    if (direction > 0 && rate < 2) {\n193\t      rate += 0.25\n194\t    } else if (direction < 0 && rate > 0.25 && rate <= 2) {\n195\t      rate -= 0.25\n196\t    } else if (direction > 0 && rate >= 1 && rate < 16) {\n197\t      rate *= 2\n198\t    } else if (direction < 0 && rate > 1 && rate <= 16) {\n199\t      rate /= 2\n200\t    }\n201\t    state.playing.playbackRate = rate\n202\t    // A device that cannot change rate -- every Chromecast -- plays at\n203\t    // normal speed and the UI says so, which is what `Cast.setRate()`'s\n204\t    // boolean return meant before the call became asynchronous.\n205\t    if (isCasting(state)) {\n206\t      if (canSetRate(state)) reportErrors(cast.setRate(rate))\n207\t      else state.playing.playbackRate = 1\n208\t    }\n209\t    // Wait a bit before we hide the controls and header again\n210\t    state.playing.mouseStationarySince = new Date().getTime()\n211\t  }\n212\t\n213\t  // Change the volume, in range [0, 1], by some amount\n214\t  // For example, volume muted (0), changeVolume (0.3) increases to 30% volume\n215\t  changeVolume (delta) {\n216\t    // change volume with delta value\n217\t    this.setVolume(this.state.playing.volume + delta)\n218\t  }\n219\t\n220\t  // Set the volume to some value in [0, 1]\n221\t  setVolume (volume) {\n222\t    // check if its in [0.0 - 1.0] range\n223\t    volume = Math.max(0, Math.min(1, volume))\n224\t\n225\t    const state = this.state\n226\t    if (isCasting(state)) {\n227\t      reportErrors(cast.setVolume(volume))\n228\t    } else {\n229\t      state.playing.setVolume = volume\n230\t    }\n231\t  }\n232\t\n233\t  // Hide player controls while playing video, if the mouse stays still for a while\n234\t  // Never hide the controls when:\n235\t  // * The mouse is over the controls or we're scrubbing (see CSS)\n236\t  // * The video is paused\n237\t  // * The video is playing remotely on Chromecast or Airplay\n238\t  showOrHidePlayerControls () {\n239\t    const state = this.state\n240\t    const hideControls = state.shouldHidePlayerControls()\n241\t\n242\t    if (hideControls !== state.playing.hideControls) {\n243\t      state.playing.hideControls = hideControls\n244\t      return true\n245\t    }\n246\t    return false\n247\t  }\n248\t\n249\t  // Opens the video player to a specific torrent\n250\t  openPlayer (infoHash, index, cb) {\n251\t    const state = this.state\n252\t    const torrentSummary = TorrentSummary.getByKey(state, infoHash)\n253\t\n254\t    state.playing.infoHash = torrentSummary.infoHash\n255\t    state.playing.isReady = false\n256\t\n257\t    // update UI to show pending playback\n258\t    sound.play('PLAY')\n259\t\n260\t    this.startServer(torrentSummary)\n261\t    reportErrors(ipcOs.notifyPlayerOpen())\n262\t    this.updatePlayer(infoHash, index, true, cb)\n263\t  }\n264\t\n265\t  // Starts WebTorrent server for media streaming\n266\t  startServer (torrentSummary) {\n267\t    const state = this.state\n268\t    // `closePlayer` replaces `state.playing`, so a delivery that races\n269\t    // the close finds a different object and leaves it alone.\n270\t    const playing = state.playing\n271\t\n272\t    const onTorrentReady = () => {\n273\t      if (state.playing !== playing) return\n274\t      // Addressed by info hash: since ADR-013 poster generation starts\n275\t      // servers too, so the broadcast channel can carry a server for a\n276\t      // torrent the user is not watching.\n277\t      this.keepSubscription(ipcEngine.onServerRunningFor(\n278\t        torrentSummary.infoHash,\n279\t        () => {\n280\t          if (state.playing === playing) playing.isReady = true\n281\t        },\n282\t        { once: true }))\n283\t      this.serverInfoHash = torrentSummary.infoHash\n284\t      reportErrors(ipcEngine.startServer(torrentSummary.infoHash))\n285\t    }\n286\t\n287\t    if (torrentSummary.status === 'paused') {\n288\t      dispatch('startTorrentingSummary', torrentSummary.torrentKey)\n289\t      this.keepSubscription(ipcEngine.onTorrentReadyFor(\n290\t        torrentSummary.infoHash, onTorrentReady, { once: true }))\n291\t    } else {\n292\t      onTorrentReady()\n293\t    }\n294\t  }\n295\t\n296\t  // Holds on to a subscription made for the current play, so\n297\t  // `closePlayer` can withdraw it -- even if the close arrives before\n298\t  // the shim has handed back the unsubscribe.\n299\t  keepSubscription (subscribing) {\n300\t    let cancelled = false\n301\t    let unsubscribe = null\n302\t    this.subscriptions.push(() => {\n303\t      cancelled = true\n304\t      if (unsubscribe) unsubscribe()\n305\t    })\n306\t    reportErrors(subscribing.then((unsub) => {\n307\t      if (cancelled) unsub()\n308\t      else unsubscribe = unsub\n309\t    }))\n310\t  }\n311\t\n312\t  // Called each time the current file changes\n313\t  updatePlayer (infoHash, index, resume, cb) {\n314\t    const state = this.state\n315\t\n316\t    const torrentSummary = TorrentSummary.getByKey(state, infoHash)\n317\t    const fileSummary = torrentSummary.files[index]\n318\t\n319\t    if (!TorrentPlayer.isPlayable(fileSummary)) {\n320\t      torrentSummary.mostRecentFileIndex = undefined\n321\t      return cb(new UnplayableFileError())\n322\t    }\n323\t\n324\t    torrentSummary.mostRecentFileIndex = index\n325\t\n326\t    // update state\n327\t    state.playing.infoHash = infoHash\n328\t    state.playing.fileIndex = index\n329\t    state.playing.fileName = fileSummary.name\n330\t    state.playing.type = TorrentPlayer.isVideo(fileSummary)\n331\t      ? 'video'\n332\t      : TorrentPlayer.isAudio(fileSummary)\n333\t        ? 'audio'\n334\t        : 'other'\n335\t\n336\t    // pick up where we left off\n337\t    let jumpToTime = 0\n338\t    if (resume && fileSummary.currentTime) {\n339\t      const fraction = fileSummary.currentTime / fileSummary.duration\n340\t      const secondsLeft = fileSummary.duration - fileSummary.currentTime\n341\t      if (fraction < 0.9 && secondsLeft > 10) {\n342\t        jumpToTime = fileSummary.currentTime\n343\t      }\n344\t    }\n345\t    state.playing.jumpToTime = jumpToTime\n346\t\n347\t    // if it's audio, parse out the metadata (artist, title, etc)\n348\t    const playing = state.playing\n349\t    if (torrentSummary.status === 'paused') {\n350\t      this.keepSubscription(ipcEngine.onTorrentReadyFor(\n351\t        torrentSummary.infoHash, getAudioMetadata, { once: true }))\n352\t    } else {\n353\t      getAudioMetadata()\n354\t    }\n355\t\n356\t    function getAudioMetadata () {\n357\t      if (state.playing !== playing) return\n358\t      if (playing.type === 'audio') {\n359\t        reportErrors(\n360\t          ipcEngine.getAudioMetadata(torrentSummary.infoHash, index))\n361\t      }\n362\t    }\n363\t\n364\t    // if it's video, check for subtitles files that are done downloading\n365\t    dispatch('checkForSubtitles')\n366\t\n367\t    // enable previously selected subtitle track\n368\t    if (fileSummary.selectedSubtitle) {\n369\t      dispatch('addSubtitles', [fileSummary.selectedSubtitle], true)\n370\t    }\n371\t\n372\t    state.window.title = fileSummary.name\n373\t\n374\t    // play in VLC if set as default player (Preferences / Playback / Play in VLC)\n375\t    if (this.state.saved.prefs.openExternalPlayer) {\n376\t      dispatch('openExternalPlayer')\n377\t      this.update()\n378\t      cb()\n379\t      return\n380\t    }\n381\t\n382\t    // otherwise, play the video\n383\t    this.update()\n384\t\n385\t    reportErrors(ipcOs.notifyPlayerUpdate(\n386\t      Playlist.hasNext(state), Playlist.hasPrevious(state)))\n387\t    cb()\n388\t  }\n389\t\n390\t  closePlayer () {\n391\t    console.log('closePlayer')\n392\t\n393\t    // Quit any external players, like Chromecast/Airplay/etc or VLC.\n394\t    // Through the cast controller rather than straight at the shim:\n395\t    // ending a session also drops the mirrored device, which is state\n396\t    // this controller does not own.\n397\t    const state = this.state\n398\t    if (isCasting(state)) {\n399\t      dispatch('stopCasting')\n400\t    }\n401\t    if (state.playing.location === 'external') {\n402\t      reportErrors(ipcOs.quitExternalPlayer())\n403\t    }\n404\t    // A wait for the server to open the external player is over too.\n405\t    dispatch('playerClosed')\n406\t\n407\t    // So is every wait this play made on the engine.\n408\t    this.subscriptions.splice(0).forEach((cancel) => cancel())\n409\t\n410\t    // Save volume (this session only, not in state.saved)\n411\t    state.previousVolume = state.playing.volume\n412\t\n413\t    // Reset the window contents back to the home screen\n414\t    state.playing = State.getDefaultPlayState()\n415\t    state.server = null\n416\t\n417\t    // Reset the window size and location back to where it was\n418\t    if (state.window.isFullScreen) {\n419\t      dispatch('toggleFullScreen', false)\n420\t    }\n421\t    restoreBounds(state)\n422\t\n423\t    // Release our hold on the torrent-to-HTTP server, if this play took\n424\t    // one. Sending a stop it never matched would release someone else's\n425\t    // hold -- a poster job's, say (ADR-013 counts holders per torrent).\n426\t    if (this.serverInfoHash !== null) {\n427\t      reportErrors(ipcEngine.stopServer(this.serverInfoHash))\n428\t      this.serverInfoHash = null\n429\t    }\n430\t\n431\t    reportErrors(ipcOs.notifyPlayerClose())\n432\t\n433\t    // Playback Priority: resume previously paused downloads.\n434\t    if (this.state.saved.prefs.highestPlaybackPriority) {\n435\t      dispatch('resumePausedTorrents')\n436\t    }\n437\t\n438\t    this.update()\n439\t  }\n440\t}\n441\t\n442\t// Checks whether we are connected and already casting\n443\t// Returns false if we not casting (state.playing.location === 'local')\n444\t// or if we're trying to connect but haven't yet ('chromecast-pending', etc)\n445\tfunction isCasting (state) {\n446\t  return state.playing.location === 'chromecast' ||\n447\t    state.playing.location === 'airplay' ||\n448\t    state.playing.location === 'dlna'\n449\t}\n450\t\n451\tfunction restoreBounds (state) {\n452\t  reportErrors(ipcOs.setAspectRatio(0))\n453\t  if (state.window.bounds) {\n454\t    reportErrors(ipcOs.setBounds(state.window.bounds, false))\n455\t  }\n456\t}\n457\t"}]},"parent_tool_use_id":null,"session_id":"52417f48-72df-4c88-8824-cc460bf7ab25","uuid":"b7a2bc5c-1ce9-4b09-9c25-7a12b4d4f883","timestamp":"2026-10-18T01:33:00.747Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/webtorrent-desktop.review-fix/src/renderer/controllers/playback-controller.js","content":"import path from 'path'\n\nimport { canSetRate } from '../lib/cast-mirror'\nimport { dispatch, reportErrors } from '../lib/dispatcher'\nimport { UnplayableFileError, UnplayableTorrentError } from '../lib/errors'\nimport * as sound from '../lib/sound'\nimport * as TorrentPlayer from '../lib/torrent-player'\nimport * as TorrentSummary from '../lib/torrent-summary'\nimport * as cast from '../lib/platform/cast'\nimport * as ipcEngine from '../lib/platform/ipc-engine'\nimport * as ipcOs from '../lib/platform/ipc-os'\nimport * as shell from '../lib/platform/shell'\nimport * as Playlist from '../lib/playlist'\nimport State from '../lib/state'\n\n// Controls playback of torrents and files within torrents\n// both local (<video>,<audio>,external player) and remote (cast)\nexport default class PlaybackController {\n  constructor (state, config, update) {\n    this.state = state\n    this.config = config\n    this.update = update\n    // Withdraws each engine subscription made for the current play.\n    this.subscriptions = []\n    // The info hash whose server this play asked for, if it did.\n    this.serverInfoHash = null\n  }\n\n  // Play a file in a torrent.\n  // * Start torrenting, if necessary\n  // * Stream, if not already fully downloaded\n  // * If no file index is provided, restore the most recently viewed file or autoplay the first\n  playFile (infoHash, index /* optional */) {\n    this.pauseActiveTorrents(infoHash)\n\n    const state = this.state\n    if (state.location.url() === 'player') {\n      this.updatePlayer(infoHash, index, false, (err) => {\n        if (err) return dispatch('error', err)\n        this.play()\n        dispatch('checkMediaPlayability')\n      })\n    } else {\n      let initialized = false\n      state.location.go({\n        url: 'player',\n        setup: (cb) => {\n          const torrentSummary = TorrentSummary.getByKey(state, infoHash)\n\n          if (index === undefined || initialized) index = torrentSummary.mostRecentFileIndex\n          if (index === undefined) index = torrentSummary.files.findIndex(TorrentPlayer.isPlayable)\n          if (index === undefined) return cb(new UnplayableTorrentError())\n\n          initialized = true\n\n          this.openPlayer(infoHash, index, (err) => {\n            if (!err) this.play()\n            cb(err)\n          })\n        },\n        destroy: () => this.closePlayer()\n      }, (err) => {\n        if (err) return dispatch('error', err)\n        // Not from inside `setup`: `location-history` sets the current\n        // page only once setup has called back, and the modal is\n        // opened by `mediaError`, which ignores anything dispatched\n        // while the location is still the torrent list.\n        dispatch('checkMediaPlayability')\n      })\n    }\n  }\n\n  // Open a file in OS default app.\n  openPath (infoHash, index) {\n    const torrentSummary = TorrentSummary.getByKey(this.state, infoHash)\n    const filePath = path.join(\n      torrentSummary.path,\n      torrentSummary.files[index].path)\n    reportErrors(shell.openPath(filePath))\n  }\n\n  // Toggle (play or pause) the currently playing media\n  playPause () {\n    const state = this.state\n    if (state.location.url() !== 'player') return\n\n    // force rerendering if window is hidden,\n    // in order to bypass `raf` and play/pause media immediately\n    const mediaTag = document.querySelector('video,audio')\n    if (!state.window.isVisible && mediaTag) {\n      if (state.playing.isPaused) mediaTag.play()\n      else mediaTag.pause()\n    }\n\n    if (state.playing.isPaused) this.play()\n    else this.pause()\n  }\n\n  pauseActiveTorrents (infoHash) {\n    // Playback Priority: pause all active torrents if needed.\n    if (!this.state.saved.prefs.highestPlaybackPriority) return\n\n    // Do not pause active torrents if playing a fully downloaded torrent.\n    const torrentSummary = TorrentSummary.getByKey(this.state, infoHash)\n    if (torrentSummary.status === 'seeding') return\n\n    dispatch('prioritizeTorrent', infoHash)\n  }\n\n  // Play next file in list (if any)\n  nextTrack () {\n    const state = this.state\n    if (Playlist.hasNext(state) && state.playing.location !== 'external') {\n      this.updatePlayer(\n        state.playing.infoHash, Playlist.getNextIndex(state), false, (err) => {\n          if (err) dispatch('error', err)\n          else this.play()\n        })\n    }\n  }\n\n  // Play previous track in list (if any)\n  previousTrack () {\n    const state = this.state\n    if (Playlist.hasPrevious(state) && state.playing.location !== 'external') {\n      this.updatePlayer(\n        state.playing.infoHash, Playlist.getPreviousIndex(state), false, (err) => {\n          if (err) dispatch('error', err)\n          else this.play()\n        })\n    }\n  }\n\n  // Play (unpause) the current media\n  play () {\n    const state = this.state\n    if (!state.playing.isPaused) return\n    state.playing.isPaused = false\n    if (isCasting(state)) {\n      reportErrors(cast.play())\n    }\n    reportErrors(ipcOs.notifyPlayerPlay())\n  }\n\n  // Pause the currently playing media\n  pause () {\n    const state = this.state\n    if (state.playing.isPaused) return\n    state.playing.isPaused = true\n    if (isCasting(state)) {\n      reportErrors(cast.pause())\n    }\n    reportErrors(ipcOs.notifyPlayerPause())\n  }\n\n  // Skip specified number of seconds (backwards if negative)\n  skip (time) {\n    this.skipTo(this.state.playing.currentTime + time)\n  }\n\n  // Skip (aka seek) to a specific point, in seconds\n  skipTo (time) {\n    if (!Number.isFinite(time)) {\n      console.error('Tried to skip to a non-finite time ' + time)\n      return console.trace()\n    }\n    if (isCasting(this.state)) reportErrors(cast.seek(time))\n    else this.state.playing.jumpToTime = time\n  }\n\n  // Show video preview\n  preview (x) {\n    if (!Number.isFinite(x)) {\n      console.error('Tried to preview a non-finite position ' + x)\n      return console.trace()\n    }\n    this.state.playing.previewXCoord = x\n  }\n\n  // Hide video preview\n  clearPreview () {\n    this.state.playing.previewXCoord = null\n  }\n\n  // Change playback speed. 1 = faster, -1 = slower\n  // Playback speed ranges from 16 (fast forward) to 1 (normal playback)\n  // to 0.25 (quarter-speed playback), then goes to -0.25, -0.5, -1, -2, etc\n  // until -16 (fast rewind)\n  changePlaybackRate (direction) {\n    const state = this.state\n    let rate = state.playing.playbackRate\n    if (direction > 0 && rate < 2) {\n      rate += 0.25\n    } else if (direction < 0 && rate > 0.25 && rate <= 2) {\n      rate -= 0.25\n    } else if (direction > 0 && rate >= 1 && rate < 16) {\n      rate *= 2\n    } else if (direction < 0 && rate > 1 && rate <= 16) {\n      rate /= 2\n    }\n    state.playing.playbackRate = rate\n    // A device that cannot change rate -- every Chromecast -- plays at\n    // normal speed and the UI says so, which is what `Cast.setRate()`'s\n    // boolean return meant before the call became asynchronous.\n    if (isCasting(state)) {\n      if (canSetRate(state)) reportErrors(cast.setRate(rate))\n      else state.playing.playbackRate = 1\n    }\n    // Wait a bit before we hide the controls and header again\n    state.playing.mouseStationarySince = new Date().getTime()\n  }\n\n  // Change the volume, in range [0, 1], by some amount\n  // For example, volume muted (0), changeVolume (0.3) increases to 30% volume\n  changeVolume (delta) {\n    // change volume with delta value\n    this.setVolume(this.state.playing.volume + delta)\n  }\n\n  // Set the volume to some value in [0, 1]\n  setVolume (volume) {\n    // check if its in [0.0 - 1.0] range\n    volume = Math.max(0, Math.min(1, volume))\n\n    const state = this.state\n    if (isCasting(state)) {\n      reportErrors(cast.setVolume(volume))\n    } else {\n      state.playing.setVolume = volume\n    }\n  }\n\n  // Hide player controls while playing video, if the mouse stays still for a while\n  // Never hide the controls when:\n  // * The mouse is over the controls or we're scrubbing (see CSS)\n  // * The video is paused\n  // * The video is playing remotely on Chromecast or Airplay\n  showOrHidePlayerControls () {\n    const state = this.state\n    const hideControls = state.shouldHidePlayerControls()\n\n    if (hideControls !== state.playing.hideControls) {\n      state.playing.hideControls = hideControls\n      return true\n    }\n    return false\n  }\n\n  // Opens the video player to a specific torrent\n  openPlayer (infoHash, index, cb) {\n    const state = this.state\n    const torrentSummary = TorrentSummary.getByKey(state, infoHash)\n\n    state.playing.infoHash = torrentSummary.infoHash\n    state.playing.isReady = false\n\n    // update UI to show pending playback\n    sound.play('PLAY')\n\n    this.startServer(torrentSummary)\n    reportErrors(ipcOs.notifyPlayerOpen())\n    this.updatePlayer(infoHash, index, true, cb)\n  }\n\n  // Starts WebTorrent server for media streaming\n  startServer (torrentSummary) {\n    const state = this.state\n    // `closePlayer` replaces `state.playing`, so a delivery that races\n    // the close finds a different object and leaves it alone.\n    const playing = state.playing\n\n    const onTorrentReady = () => {\n      if (state.playing !== playing) return\n      // Addressed by info hash: since ADR-013 poster generation starts\n      // servers too, so the broadcast channel can carry a server for a\n      // torrent the user is not watching.\n      this.keepSubscription(ipcEngine.onServerRunningFor(\n        torrentSummary.infoHash,\n        () => {\n          if (state.playing === playing) playing.isReady = true\n        },\n        { once: true }))\n      this.serverInfoHash = torrentSummary.infoHash\n      reportErrors(ipcEngine.startServer(torrentSummary.infoHash))\n    }\n\n    if (torrentSummary.status === 'paused') {\n      dispatch('startTorrentingSummary', torrentSummary.torrentKey)\n      this.keepSubscription(ipcEngine.onTorrentReadyFor(\n        torrentSummary.infoHash, onTorrentReady, { once: true }))\n    } else {\n      onTorrentReady()\n    }\n  }\n\n  // Holds on to a subscription made for the current play, so\n  // `closePlayer` can withdraw it -- even if the close arrives before\n  // the shim has handed back the unsubscribe.\n  keepSubscription (subscribing) {\n    let cancelled = false\n    let unsubscribe = null\n    this.subscriptions.push(() => {\n      cancelled = true\n      if (unsubscribe) unsubscribe()\n    })\n    reportErrors(subscribing.then((unsub) => {\n      if (cancelled) unsub()\n      else unsubscribe = unsub\n    }))\n  }\n\n  // Called each time the current file changes\n  updatePlayer (infoHash, index, resume, cb) {\n    const state = this.state\n\n    const torrentSummary = TorrentSummary.getByKey(state, infoHash)\n    const fileSummary = torrentSummary.files[index]\n\n    if (!TorrentPlayer.isPlayable(fileSummary)) {\n      torrentSummary.mostRecentFileIndex = undefined\n      return cb(new UnplayableFileError())\n    }\n\n    torrentSummary.mostRecentFileIndex = index\n\n    // update state\n    state.playing.infoHash = infoHash\n    state.playing.fileIndex = index\n    state.playing.fileName = fileSummary.name\n    state.playing.type = TorrentPlayer.isVideo(fileSummary)\n      ? 'video'\n      : TorrentPlayer.isAudio(fileSummary)\n        ? 'audio'\n        : 'other'\n\n    // pick up where we left off\n    let jumpToTime = 0\n    if (resume && fileSummary.currentTime) {\n      const fraction = fileSummary.currentTime / fileSummary.duration\n      const secondsLeft = fileSummary.duration - fileSummary.currentTime\n      if (fraction < 0.9 && secondsLeft > 10) {\n        jumpToTime = fileSummary.currentTime\n      }\n    }\n    state.playing.jumpToTime = jumpToTime\n\n    // if it's audio, parse out the metadata (artist, title, etc)\n    const playing = state.playing\n    if (torrentSummary.status === 'paused') {\n      this.keepSubscription(ipcEngine.onTorrentReadyFor(\n        torrentSummary.infoHash, getAudioMetadata, { once: true }))\n    } else {\n      getAudioMetadata()\n    }\n\n    function getAudioMetadata () {\n      if (state.playing !== playing) return\n      if (playing.type === 'audio') {\n        reportErrors(\n          ipcEngine.getAudioMetadata(torrentSummary.infoHash, index))\n      }\n    }\n\n    // if it's video, check for subtitles files that are done downloading\n    dispatch('checkForSubtitles')\n\n    // enable previously selected subtitle track\n    if (fileSummary.selectedSubtitle) {\n      dispatch('addSubtitles', [fileSummary.selectedSubtitle], true)\n    }\n\n    state.window.title = fileSummary.name\n\n    // play in VLC if set as default player (Preferences / Playback / Play in VLC)\n    if (this.state.saved.prefs.openExternalPlayer) {\n      dispatch('openExternalPlayer')\n      this.update()\n      cb()\n      return\n    }\n\n    // otherwise, play the video\n    this.update()\n\n    reportErrors(ipcOs.notifyPlayerUpdate(\n      Playlist.hasNext(state), Playlist.hasPrevious(state)))\n    cb()\n  }\n\n  closePlayer () {\n    console.log('closePlayer')\n\n    // Quit any external players, like Chromecast/Airplay/etc or VLC.\n    // Through the cast controller rather than straight at the shim:\n    // ending a session also drops the mirrored device, which is state\n    // this controller does not own.\n    const state = this.state\n    if (isCasting(state)) {\n      dispatch('stopCasting')\n    }\n    if (state.playing.location === 'external') {\n      reportErrors(ipcOs.quitExternalPlayer())\n    }\n    // A wait for the server to open the external player is over too.\n    dispatch('playerClosed')\n\n    // So is every wait this play made on the engine.\n    this.subscriptions.splice(0).forEach((cancel) => cancel())\n\n    // Save volume (this session only, not in state.saved)\n    state.previousVolume = state.playing.volume\n\n    // Reset the window contents back to the home screen\n    state.playing = State.getDefaultPlayState()\n    state.server = null\n\n    // Reset the window size and location back to where it was\n    if (state.window.isFullScreen) {\n      dispatch('toggleFullScreen', false)\n    }\n    restoreBounds(state)\n\n    // Release our hold on the torrent-to-HTTP server, if this play took\n    // one. Sending a stop it never matched would release someone else's\n    // hold -- a poster job's, say (ADR-013 counts holders per torrent).\n    if (this.serverInfoHash !== null) {\n      reportErrors(ipcEngine.stopServer(this.serverInfoHash))\n      this.serverInfoHash = null\n    }\n\n    reportErrors(ipcOs.notifyPlayerClose())\n\n    // Playback Priority: resume previously paused downloads.\n    if (this.state.saved.prefs.highestPlaybackPriority) {\n      dispatch('resumePausedTorrents')\n    }\n\n    this.update()\n  }\n}\n\n// Checks whether we are connected and already casting\n// Returns false if we not casting (state.playing.location === 'local')\n// or if we're trying to connect but haven't yet ('chromecast-pending', etc)\nfunction isCasting (state) {\n  return state.playing.location === 'chromecast' ||\n    state.playing.location === 'airplay' ||\n    state.playing.location === 'dlna'\n}\n\nfunction restoreBounds (state) {\n  reportErrors(ipcOs.setAspectRatio(0))\n  if (state.window.bounds) {\n    reportErrors(ipcOs.setBounds(state.window.bounds, false))\n  }\n}\n","numLines":457,"startLine":1,"totalLines":457}},"tool_result_meta":[{"id":"toolu_017kYXKicVKuytNkHMLmtMHS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E8NuA1PeDtJFGtE2uRB3gp","type":"tool_result","content":"# test/\n\nOne suite lives here now.\n\n## The integration suite is gone (US-072)\n\n`npm run test-integration` ran `tape` through Spectron against the real\nElectron app: `test/index.js` required each `test/test-*.js`, and\n`test/setup.js`, `test/mocks.js`, `test/resources/` and\n`test/screenshots/` supported it. US-072 deleted all of it with the\nhost it drove. **Do not restore any of it.** Spectron drives Electron\nover the ChromeDriver protocol and has no Tauri counterpart, and it had\nnot run on this branch anyway: Spectron 19 cannot drive Electron 27\nunder the installed Node, so every run died with\n`Error: Application not running` on the first test -- verified at HEAD\nbefore the branch, so it was broken before the port started rather than\nby it.\n\nWhat replaces it, and when:\n\n- **Now.** The unit suite below plus the host-side checks it already\n  carries. `tauri-host.js` holds the launch wiring (the document root,\n  the window declaration, the sidecar path, the port line),\n  `electron-removed.js` holds the cutover, and `engine-entry.js` runs\n  the real sidecar in a child process over a real socket. Between them\n  the automated coverage of \"the app can start\" is higher than the\n  Spectron suite's was while it was failing.\n- **US-073**, the Phase 4 verification pass, is the manual smoke test\n  in the meantime. It is a human at a window, and it is deliberately\n  not automated: the thing being verified is a webview nothing in this\n  repo can yet drive.\n- **A replacement harness is not scoped to a story yet.** The candidate\n  is WebDriver against `tauri-driver`, which is Tauri's own answer and\n  speaks the same protocol Spectron did, so the deleted `test-*.js`\n  files are readable as a specification of what to reimplement -- they\n  are in the history at `70b91d0`. Whoever picks it up should know it\n  needs `webkit2gtk-driver` on Linux and Edge WebDriver on Windows, and\n  that **macOS is unsupported by `tauri-driver`**, which is the machine\n  this port is being developed on. That is why this is a plan rather\n  than a story: on this hardware it would be a harness nobody here can\n  run.\n\n## Unit (`npm run test-unit`)\n\n`test/unit/*.js` is globbed by the `test-unit` script, so a new file\nis picked up with no registration. `npm test` runs `test-unit` after\n`standard` and `depcheck`.\n\nUnit tests are **CommonJS** and require the Babel output under\n`build/`, not the ESM sources under `src/`:\n\n```js\nconst { calculateEta } = require('../../build/renderer/lib/time')\n```\n\n`src/renderer/` is ESM and the rest of the repo is CommonJS loaded by\nNode directly, so plain `require('../../src/renderer/lib/time')` fails\non the `export` keyword. `test-unit` therefore runs `npm run\nbuild:node` first (it was `build:main` until US-072 renamed it, there\nbeing no main process left to name); do not run\n`npx tape test/unit/*.js` on its own unless you have just built, or you\nare testing a stale copy of the source.\n\nThe stub recipes below share one trap, so it is stated once here. A\nstub's `exports` **object** is bound at the first require of the module\nunder test -- Babel keeps the result of its single `require()` call. A\nhelper that rebuilds the whole stub between tests therefore leaves the\nmodule talking to the first one, silently. Swap the recording state\nbehind stable stub functions, or put getters on one `exports` object\n(see `test/unit/platform-menu.js`).\n\n### Stubbing `@tauri-apps/api` in a unit test\n\nSeed `require.cache` before the first require of the module under\ntest, at `require.resolve('@tauri-apps/api/event')` and\n`require.resolve('@tauri-apps/api/core')`:\n\n```js\nconst corePath = require.resolve('@tauri-apps/api/core')\nrequire.cache[corePath] = {\n  id: corePath,\n  filename: corePath,\n  loaded: true,\n  exports: { __esModule: true, invoke: (...args) => handler(...args) }\n}\nconst mod = require('../../build/renderer/lib/platform/window')\n```\n\n`__esModule: true` matters: every shim module imports the API as named\nESM imports, and without it Babel's interop wraps the stub in a\n`default`. The package ships a CJS build, so an unstubbed `require()`\nof it *succeeds* -- the failure of a missed stub is a real `invoke` at\ncall time rather than a load error, which is why the stub has to be in\nplace before the require rather than merely before the assertion.\n\nSeveral files stub the same subpath -- `platform-clipboard.js`,\n`platform-dialog.js`, `platform-shell.js`, `platform-ipc-os.js` and\n`platform-window.js`, each for its own shim module -- and each\noverwrites the previous one's `require.cache` entry. Each module keeps\nthe `exports` object that was there when *it* was first required, so\nthe recorders do not collide -- but a test that swaps a stub function\nmid-run has to hold its own reference to that object rather than\nreaching through `require.cache`, which by then holds another file's.\nKeeping the stub in a local and having its `invoke` delegate to a\nswappable handler sidesteps the question entirely; `platform-dialog.js`\ndoes that.\n\nGlob order decides who is first, and it is the alphabetical order of\nthe filenames: `platform-clipboard.js` seeds the entry and the rest\nreplace it. `platform-stubs.js` requires every shim module inside its\ntest callbacks (after all files have loaded), so every stub is in place\nby then.\n\nA shim that subscribes to a host event **once for the life of the\npage** (`menu.js` does, and any module that keeps a standing listener\nbehind a `let subscription` will) needs its recorded listeners kept\nacross a per-test reset. Clearing them leaves every test after the\nfirst delivering events to nobody, and the failure reads as \"the\ncallback did not run\" rather than as a broken stub. Reset the call\nrecords and leave the listener list alone; `platform-menu.js` says so\nwhere it does it.\n\n### Stubbing a Node builtin (`fs/promises`) in a unit test\n\nThe `require.cache` route does **not** work for builtins -- Node never\nconsults the cache for them, so seeding `require.resolve('fs/promises')`\nhas no effect. Their exports are plain writable properties on one\nshared module object instead, and Babel emits the same per-call-site\n`_promises.readFile` property read, so assigning over those properties\nbefore a call and restoring them after does the same job:\n\n```js\nconst fsp = require('fs/promises')\nconst real = fsp.readFile\nfsp.readFile = async (...args) => { calls.push(args); return stubbed }\n// ... exercise the module, then:\nfsp.readFile = real\n```\n\nAlways restore in the same test, or later tests (and tape itself) run\nagainst the stub. See `test/unit/platform-fs.js`.\n\n### Running a module against a real filesystem (`test/fs-shim.js`)\n\nUntil US-072 the fs shim *was* a thin wrapper over `fs/promises`, and\nthat is what let `migrations.js` and `state-file.js` run the real\nmigration and the real save/load loop against a throwaway profile. The\ncutover replaced it with nine host commands, and a host command needs a\nrunning Tauri process.\n\nSo that implementation moved to `test/fs-shim.js`. Seed it at\n`build/renderer/lib/platform/fs` and any module that reads or writes\nthrough the shim can be exercised for real. It honours the same\ncontract the shim documents -- promises, a plain `Uint8Array` out of\n`readFile`, a plain object out of `stat`, `exists` swallowing every\nstat failure -- and `test/unit/platform-fs.js` is what holds the real\nshim to that contract, so the two cannot drift silently. It lives in\n`test/` rather than `test/unit/` because `test-unit` globs\n`test/unit/*.js` as test files.\n\n### Stubbing `src/config` in a unit test\n\nA module that reads its paths from `config` can be pointed at a temp\ndirectory by seeding `require.cache[require.resolve('../../build/config')]`\nbefore the first require of the module under test. The stub's exports\nhave to look like a Babel-compiled ES module -- `{ __esModule: true,\ndefault: {...} }` -- because every renderer module imports config as a\ndefault import. `test/unit/migrations.js` uses this to run the real\nmigrations, against the real filesystem, in a throwaway profile.\n\nOnly `src/renderer/lib/**`, `src/shared/**` and `src/engine/**` are\nreachable this way. `build:node` deliberately ignores\n`src/renderer/main.js`, `components/`, `controllers/` and `pages/`\n(Vite owns those), so those modules cannot be unit tested through\n`build/`. See `src/AGENTS.md`.\n\n### Timeouts in unit tests\n\nNever wait out a production timeout. `generateTorrentPoster` takes\n`{ timeout }` as a second argument for this; `test/unit/poster.js`\npasses 30 ms. Follow that shape (an optional argument that defaults to\nthe real constant) when a new module needs a timeout tested. To test a\nreply that lands after a give-up, keep the listener the stub was\nhanded and call it yourself after the job settles.\n\n## Static boundary tests\n\nBecause `components/`, `controllers/` and `main.js` are unreachable\nthrough `build/`, the only automated check on their imports is a\nstatic one. `test/unit/platform-boundary.js` walks the **sources**\nunder `src/renderer/`, skipping `lib/platform/`, and fails on any\ndirect use of an Electron API that has already been migrated behind\nthe shim (`shell` and `clipboard`; plus, since US-027, the\n`@electron/remote` dialog API and the `getCurrentWindow().isVisible` /\n`.isMaximized` reads; plus, since US-028, any import of `fs`; plus,\nsince US-029, `new remote.Menu` / `new remote.MenuItem`; plus, since\nUS-030..US-032, any use of `ipcRenderer` at all and any `wt-` channel\nstring; plus, since US-034, any `require()` of a banned host module).\nEach of US-027..US-032 added its concern to that list as it landed.\nReading source rather than build output is the point -- do not\nrepoint it at `build/`.\n\n**US-034 did not supersede this file.** The lint rule added there\n(`eslint-boundary.config.js`, run by `npm run lint:boundary` and\ncovered by `test/unit/lint-boundary.js`) bans the import\n**specifiers** -- `electron`, `@electron/remote`, `fs`, `os`,\n`crypto`, `http` -- under `src/renderer/`, with\n`src/renderer/lib/platform/` exempt by directory glob and no per-file\nexemption at all. (US-046 dropped the `webtorrent.js` override with\nthe file and US-079 dropped `lib/cast.js`'s the same way, closing\nADR-008; US-046 also added two per-file rules\nthat *tighten* rather than exempt: `lib/platform/ipc-engine.js` is\nbanned from Electron again, and `src/engine/**` -- the sidecar -- is\nbanned from Electron and from every DOM global while keeping Node\nbuiltins. `npm run lint:boundary` lints both trees; a test asserts the\nscript still names both.) It catches a brand new file reaching for a\nhost module,\nwhich the concern-based checks here would miss. It cannot see\n`ipcRenderer.` member reads, `wt-` channel strings, `new remote.Menu`,\nor any `require()` call, which is what this file is for. Add a new\nbanned **specifier** to the lint config; add a new banned **usage** to\nthis file.\n\n`lint-boundary.js` drives the config through ESLint's Node API\n(`new ESLint({ useEslintrc: false, overrideConfigFile })`) rather than\nshelling out, so it can `lintText()` synthetic sources at a chosen\n`filePath` and prove an exemption actually exempts without creating a\nthrowaway file under `src/`. Do not rewrite it to write probe files:\na crashed run would leave them behind for `standard` to trip over.\n\nThe OS-IPC check walked a hand-maintained file list while the\nmigration was partial. Since US-031 it walks the whole renderer, and\nsince US-032 -- with both IPC concerns migrated -- the OS and `wt-*`\nchecks collapsed into one: no `ipcRenderer` and no `wt-` string\nliteral anywhere outside `lib/platform/`, plus an exact assertion on\nwhich renderer files still import a host module at all (since US-039,\nnone). There is no \"left alone for a later story\" counterpart any\nmore, because there is nothing left. The Electron spellings it scans\nfor outlived the host: US-072 deleted every one of them, and the scan\nis what keeps a reflex from bringing one back.\n\nThe `fs` check is the one exception to the rule below: `fs` is a Node\nbuiltin with a single concern behind it, so it bans the specifier\noutright, with no exemption since US-045 deleted `webtorrent.js`.\n\nSince US-046 this file also scans `src/engine/` for the mirror-image\nmistake -- an Electron import or a DOM global in the sidecar -- and\nscans `lib/platform/ipc-engine.js`, which every renderer walk here\nskips because it is inside the shim.\n\nThe checks name **concerns, not module specifiers**. Add a pattern for\nwhat your story actually migrated, not for the import it happens to sit\nnext to. (Up to US-029 that mattered because `remote.Menu` and\n`remote.dialog` lived in the same file and left in different stories.)\n\n## Unit testing a controller\n\nControllers are outside `build:node`, so there is no prebuilt copy to\nrequire. `test/unit/torrent-context-menu.js` compiles the one file\nunder test with `@babel/core` (`transformFileSync(src, { root, cwd })`\npicks up the `babel` key in `package.json`) and writes the result into\n`build/renderer/controllers/`. Emitting it *there* is what makes the\ncontroller's own `../lib/...` imports resolve against the real built\n`build/renderer/lib/**`; a temp directory would not resolve at all.\nStub the shim modules it imports by `require.cache`-seeding their\nbuilt paths, and record dispatches through the real\n`lib/dispatcher`'s `setDispatch()` rather than stubbing it.\n\n`test/unit/os-ipc-call-sites.js` follows the same recipe for the\nUS-030 controllers and `test/unit/engine-ipc-call-sites.js` for the\nUS-032 ones. Cross-file hazards these had to solve, all because\n`tape test/unit/*.js` is a **single process** that requires every file\nbefore running any test:\n\n- **`setDispatch()` is process-wide.** Registering it once at require\n  time means the last file loaded wins for the entire run. Call\n  `setDispatch()` inside each file's per-test `reset()` instead.\n- **A `require.cache` stub of a *built shim module* leaks into later\n  files.** `platform-ipc-os.js` tests the real `ipc-os`, so a stub left\n  at its path breaks it. Withdraw the stub (restore the previous cache\n  entry, or `delete` it) right after requiring the module under test --\n  Babel binds the imported module object at that first require, so the\n  module under test keeps the stub afterwards. Stubs of a package that\n  is not itself a shim module -- `@tauri-apps/api/core`, say -- do not\n  need this; every file that cares seeds its own.\n- **Two files compiling the same controller collide.** The compiled\n  copy is keyed in `require.cache` by its emitted path, so whichever\n  file loads first hands its stubs to the other.\n  `engine-ipc-call-sites.js` emits under a `.engine-test.js` suffix\n  into the same directory, and `media-controller-playability.js` under\n  `.playability-test.js` (the directory is what resolves `../lib/...`,\n  not the file name). Both collide with `os-ipc-call-sites.js`, which\n  emits `media-controller.js` itself. Likewise\n  `torrent-list-resume.js` emits `torrent-list-controller` under\n  `.resume-test.js`, since `torrent-context-menu.js` owns the plain\n  name. The failure is silent and lands\n  in the *other* file: the loser's recorders stay empty while its own\n  assertions about the modal still pass, so run a new controller test\n  alongside the existing ones, both orders, before believing it.\n  The same collision used to bite two files that both required the\n  main process's `ipc` module; both those files went with the host in\n  US-072. The recipe they used is still the one to reach for when two\n  files need different stubs of the same built module:\n  `delete require.cache[...]` before requiring, then put the previous\n  entry back, so both instances keep the stubs they were built with.\n- **Stub every built module the controller graph reaches, not just the\n  one under test.** Letting a real shim module load here binds *this*\n  file's host stub into it for the whole run, which breaks\n  `platform-clipboard.js` / `platform-ipc-engine.js` later in the\n  glob. `playback-controller` reaches `lib/state` -> `lib/migrations`\n  that way, which is exactly what `migrations.js` tests against.\n- **`migrations.js` never withdraws its `build/config` stub.** It is\n  seeded at require time and left there for the rest of the run, so a\n  later file wanting its own config has to save the previous cache\n  entry, seed its own, `require()` the module under test, and put the\n  previous one back -- `state-file.js`'s `withConfig()` helper is the\n  shape. Pointing that stub's `CONFIG_PATH`, `POSTER_PATH` and\n  `TORRENT_PATH` at a `mkdtemp` directory is what makes it safe to run\n  the *real* `lib/platform/fs` against a throwaway profile.\n- **A recording wrapper beats a fake when the claim is \"it goes\n  through the shim\".** Require the real built shim first, wrap each\n  export in a function that pushes its arguments onto an array and\n  delegates, seed *that* at the shim's path, require the module under\n  test, then restore. The assertions are then about real filesystem\n  behaviour and about the routing at once, and anything reaching for\n  `fs` directly leaves no trace in the array.\n\n## Testing `src/renderer/main.js`\n\n`main.js` cannot be required in a unit test at all -- not even with\nthe compile-it-yourself recipe above. Its module body calls\n`State.load()`, and it pulls in React, ReactDOM, every page and the\nwhole controller graph. `test/unit/main-ipc-call-sites.js` therefore\nchecks it statically, but goes one step past a channel-string ban: it\nextracts every `ipcOs.x` / `ipcEngine.x` member the file reaches for\nand resolves each against the `export function` names in the shim\nsource, so a typo'd or invented export fails there instead of\nsilently becoming `undefined` at runtime. It also asserts the set of\nshim exports covers every channel `main.js` spoke before the\nmigration, which is the only automated guard against a channel being\ndropped.\n\nThe behaviour of the shim functions themselves stays in\n`platform-ipc-os.js` / `platform-ipc-engine.js`; do not duplicate it\nhere.\n\nWhat *is* testable is the emitted bundle, which\n`test/unit/renderer-boots.js` runs in a webview-shaped sandbox: a\n`vm` context with a minimal DOM and deliberately no `require`,\n`process`, `module` or `global`. Its `__TAURI_INTERNALS__.invoke`\nrecords every command and has two modes, and the difference matters:\n\n- **Nothing answers.** Every `invoke` returns a promise that never\n  settles, so startup stops at the first host call and the recorded\n  commands are exactly what the bundle asks for before it knows\n  anything. This is how the load itself and the startup *ordering*\n  are asserted.\n- **One command answers.** Resolve `app_paths` and leave the rest\n  pending, and startup advances exactly one step further -- far\n  enough to assert what the bundle did with the answer. US-072 needed\n  this: the bootstrap reached `useHostPaths` through the wrong export\n  and threw one tick after every other test had gone green.\n- **Enough answers to boot.** `app_paths`, `fs_read_file` with an\n  existing profile (bytes as a number array) and an id for each\n  `plugin:event|listen` take startup through `ReactDOM.render` and\n  `setupIpc`. Answer `fs_read_file` with a profile rather than an\n  error: a missing one makes `State.load` build the default torrents,\n  which fetches bundled assets. Keep every other command pending; a\n  `null` from `get_engine_endpoint` starts the engine client's retry\n  timers. Wrap the sandbox's `setInterval` and clear it afterwards,\n  because startup's once-a-second `update` holds the process open.\n\nAnything asserted in the second mode runs on a later tick, so wrap it\nin a `process.on('unhandledRejection')` capture. `main.js`'s\n`bootstrap()` deliberately has no `catch` -- there is no UI to report\ninto that early -- and an uncaught rejection there lands outside any\n`try` in the test file and takes the whole `tape` process with it.\n\n## Testing the engine sidecar\n\n`test/unit/engine-entry.js` runs the real thing: it spawns\n`build/engine/index.js` with `process.execPath`, waits for the\n`WEBTORRENT_ENGINE_PORT=` line on stdout, connects a real `ws` client\nand speaks `wt-*` through `build/shared/wire.js`. Four things keep that\nhonest and cheap:\n\n- **`NODE_ENV=test` in the child's env** makes `config` portable, so the\n  run cannot touch the real profile directory.\n- **A `static/*.torrent` fixture with every file deselected.** Metadata,\n  `wt-parsed`, `wt-ready` and `wt-progress` all arrive from the torrent\n  file itself, so the assertions do not need a peer -- and nothing\n  downloads.\n- **Kill the child in a `finally`, then await its `exit`.** A leaked\n  sidecar keeps a port and a download directory.\n- **Never patch module resolution in the tape process.** All unit files\n  share one process, so the \"config loads with no electron module\" check\n  runs the patch in a `spawnSync` child instead.\n\n`createWebSocketBus` is tested against a real server and a real client\nin `engine-bus-websocket.js` rather than a fake socket: the story is\nthat the engine is reachable by a plain socket, so a stub would only\ntest the stub. Wait on a condition (`waitFor`), never on a delay.\ntest:\nAGENTS.md\nfs-shim.js\nunit/\n\ntest/unit:\naudio-tracks.js\ncast-call-sites.js\ncast-mirror.js\nconfig-host-paths.js\ndispatcher.js\nelectron-removed.js\nengine-announce.js\nengine-audio-metadata-wiring.js\nengine-audio-metadata.js\nengine-bus-websocket.js\nengine-dials-wiring.js\nengine-dials.js\nengine-entry.js\nengine-hashfail-wiring.js\nengine-hashfail.js\nengine-ipc-call-sites.js\nengine-selections.js\nengine-stall.js\nengine-sweep-wiring.js\nengine-torrent-close-wiring.js\nerror-list.js\nfetch-node.js\nlint-boundary.js\nmain-ipc-call-sites.js\nmedia-controller-external-player.js\nmedia-controller-playability.js\nmedia-playability.js\nmigrations.js\nos-ipc-call-sites.js\nos.js\npath.js\nplatform-boundary.js\nplatform-cast.js\nplatform-clipboard.js\nplatform-dialog.js\nplatform-fs.js\nplatform-ipc-engine.js\nplatform-ipc-os.js\nplatform-menu.js\nplatform-paths.js\nplatform-shell.js\nplatform-stubs.js\nplatform-window.js\nplayback-controller-subscriptions.js\nposter.js\nrenderer-boots.js\nsidecar-closure.js\nsound.js\nstage-sidecar.js\nstate-file.js\nstatic-asset.js\nsync-crate-version.js\ntauri-host.js\ntime.js\ntorrent-context-menu.js\ntorrent-list-resume.js\ntorrent-status.js\nwire.js\n     456 src/renderer/controllers/playback-controller.js\nmemory-leaks/\nstartup-ipc-signals/","is_error":false}]},"parent_tool_use_id":null,"session_id":"52417f48-72df-4c88-8824-cc460bf7ab25","uuid":"d7ec3c6b-989f-416e-a24b-ac75f1aaff48","timestamp":"2026-10-18T01:33:01.434Z","tool_use_result":{"stdout":"# test/\n\nOne suite lives here now.\n\n## The integration suite is gone (US-072)\n\n`npm run test-integration` ran `tape` through Spectron against the real\nElectron app: `test/index.js` required each `test/test-*.js`, and\n`test/setup.js`, `test/mocks.js`, `test/resources/` and\n`test/screenshots/` supported it. US-072 deleted all of it with the\nhost it drove. **Do not restore any of it.** Spectron drives Electron\nover the ChromeDriver protocol and has no Tauri counterpart, and it had\nnot run on this branch anyway: Spectron 19 cannot drive Electron 27\nunder the installed Node, so every run died with\n`Error: Application not running` on the first test -- verified at HEAD\nbefore the branch, so it was broken before the port started rather than\nby it.\n\nWhat replaces it, and when:\n\n- **Now.** The unit suite below plus the host-side checks it already\n  carries. `tauri-host.js` holds the launch wiring (the document root,\n  the window declaration, the sidecar path, the port line),\n  `electron-removed.js` holds the cutover, and `engine-entry.js` runs\n  the real sidecar in a child process over a real socket. Between them\n  the automated coverage of \"the app can start\" is higher than the\n  Spectron suite's was while it was failing.\n- **US-073**, the Phase 4 verification pass, is the manual smoke test\n  in the meantime. It is a human at a window, and it is deliberately\n  not automated: the thing being verified is a webview nothing in this\n  repo can yet drive.\n- **A replacement harness is not scoped to a story yet.** The candidate\n  is WebDriver against `tauri-driver`, which is Tauri's own answer and\n  speaks the same protocol Spectron did, so the deleted `test-*.js`\n  files are readable as a specification of what to reimplement -- they\n  are in the history at `70b91d0`. Whoever picks it up should know it\n  needs `webkit2gtk-driver` on Linux and Edge WebDriver on Windows, and\n  that **macOS is unsupported by `tauri-driver`**, which is the machine\n  this port is being developed on. That is why this is a plan rather\n  than a story: on this hardware it would be a harness nobody here can\n  run.\n\n## Unit (`npm run test-unit`)\n\n`test/unit/*.js` is globbed by the `test-unit` script, so a new file\nis picked up with no registration. `npm test` runs `test-unit` after\n`standard` and `depcheck`.\n\nUnit tests are **CommonJS** and require the Babel output under\n`build/`, not the ESM sources under `src/`:\n\n```js\nconst { calculateEta } = require('../../build/renderer/lib/time')\n```\n\n`src/renderer/` is ESM and the rest of the repo is CommonJS loaded by\nNode directly, so plain `require('../../src/renderer/lib/time')` fails\non the `export` keyword. `test-unit` therefore runs `npm run\nbuild:node` first (it was `build:main` until US-072 renamed it, there\nbeing no main process left to name); do not run\n`npx tape test/unit/*.js` on its own unless you have just built, or you\nare testing a stale copy of the source.\n\nThe stub recipes below share one trap, so it is stated once here. A\nstub's `exports` **object** is bound at the first require of the module\nunder test -- Babel keeps the result of its single `require()` call. A\nhelper that rebuilds the whole stub between tests therefore leaves the\nmodule talking to the first one, silently. Swap the recording state\nbehind stable stub functions, or put getters on one `exports` object\n(see `test/unit/platform-menu.js`).\n\n### Stubbing `@tauri-apps/api` in a unit test\n\nSeed `require.cache` before the first require of the module under\ntest, at `require.resolve('@tauri-apps/api/event')` and\n`require.resolve('@tauri-apps/api/core')`:\n\n```js\nconst corePath = require.resolve('@tauri-apps/api/core')\nrequire.cache[corePath] = {\n  id: corePath,\n  filename: corePath,\n  loaded: true,\n  exports: { __esModule: true, invoke: (...args) => handler(...args) }\n}\nconst mod = require('../../build/renderer/lib/platform/window')\n```\n\n`__esModule: true` matters: every shim module imports the API as named\nESM imports, and without it Babel's interop wraps the stub in a\n`default`. The package ships a CJS build, so an unstubbed `require()`\nof it *succeeds* -- the failure of a missed stub is a real `invoke` at\ncall time rather than a load error, which is why the stub has to be in\nplace before the require rather than merely before the assertion.\n\nSeveral files stub the same subpath -- `platform-clipboard.js`,\n`platform-dialog.js`, `platform-shell.js`, `platform-ipc-os.js` and\n`platform-window.js`, each for its own shim module -- and each\noverwrites the previous one's `require.cache` entry. Each module keeps\nthe `exports` object that was there when *it* was first required, so\nthe recorders do not collide -- but a test that swaps a stub function\nmid-run has to hold its own reference to that object rather than\nreaching through `require.cache`, which by then holds another file's.\nKeeping the stub in a local and having its `invoke` delegate to a\nswappable handler sidesteps the question entirely; `platform-dialog.js`\ndoes that.\n\nGlob order decides who is first, and it is the alphabetical order of\nthe filenames: `platform-clipboard.js` seeds the entry and the rest\nreplace it. `platform-stubs.js` requires every shim module inside its\ntest callbacks (after all files have loaded), so every stub is in place\nby then.\n\nA shim that subscribes to a host event **once for the life of the\npage** (`menu.js` does, and any module that keeps a standing listener\nbehind a `let subscription` will) needs its recorded listeners kept\nacross a per-test reset. Clearing them leaves every test after the\nfirst delivering events to nobody, and the failure reads as \"the\ncallback did not run\" rather than as a broken stub. Reset the call\nrecords and leave the listener list alone; `platform-menu.js` says so\nwhere it does it.\n\n### Stubbing a Node builtin (`fs/promises`) in a unit test\n\nThe `require.cache` route does **not** work for builtins -- Node never\nconsults the cache for them, so seeding `require.resolve('fs/promises')`\nhas no effect. Their exports are plain writable properties on one\nshared module object instead, and Babel emits the same per-call-site\n`_promises.readFile` property read, so assigning over those properties\nbefore a call and restoring them after does the same job:\n\n```js\nconst fsp = require('fs/promises')\nconst real = fsp.readFile\nfsp.readFile = async (...args) => { calls.push(args); return stubbed }\n// ... exercise the module, then:\nfsp.readFile = real\n```\n\nAlways restore in the same test, or later tests (and tape itself) run\nagainst the stub. See `test/unit/platform-fs.js`.\n\n### Running a module against a real filesystem (`test/fs-shim.js`)\n\nUntil US-072 the fs shim *was* a thin wrapper over `fs/promises`, and\nthat is what let `migrations.js` and `state-file.js` run the real\nmigration and the real save/load loop against a throwaway profile. The\ncutover replaced it with nine host commands, and a host command needs a\nrunning Tauri process.\n\nSo that implementation moved to `test/fs-shim.js`. Seed it at\n`build/renderer/lib/platform/fs` and any module that reads or writes\nthrough the shim can be exercised for real. It honours the same\ncontract the shim documents -- promises, a plain `Uint8Array` out of\n`readFile`, a plain object out of `stat`, `exists` swallowing every\nstat failure -- and `test/unit/platform-fs.js` is what holds the real\nshim to that contract, so the two cannot drift silently. It lives in\n`test/` rather than `test/unit/` because `test-unit` globs\n`test/unit/*.js` as test files.\n\n### Stubbing `src/config` in a unit test\n\nA module that reads its paths from `config` can be pointed at a temp\ndirectory by seeding `require.cache[require.resolve('../../build/config')]`\nbefore the first require of the module under test. The stub's exports\nhave to look like a Babel-compiled ES module -- `{ __esModule: true,\ndefault: {...} }` -- because every renderer module imports config as a\ndefault import. `test/unit/migrations.js` uses this to run the real\nmigrations, against the real filesystem, in a throwaway profile.\n\nOnly `src/renderer/lib/**`, `src/shared/**` and `src/engine/**` are\nreachable this way. `build:node` deliberately ignores\n`src/renderer/main.js`, `components/`, `controllers/` and `pages/`\n(Vite owns those), so those modules cannot be unit tested through\n`build/`. See `src/AGENTS.md`.\n\n### Timeouts in unit tests\n\nNever wait out a production timeout. `generateTorrentPoster` takes\n`{ timeout }` as a second argument for this; `test/unit/poster.js`\npasses 30 ms. Follow that shape (an optional argument that defaults to\nthe real constant) when a new module needs a timeout tested. To test a\nreply that lands after a give-up, keep the listener the stub was\nhanded and call it yourself after the job settles.\n\n## Static boundary tests\n\nBecause `components/`, `controllers/` and `main.js` are unreachable\nthrough `build/`, the only automated check on their imports is a\nstatic one. `test/unit/platform-boundary.js` walks the **sources**\nunder `src/renderer/`, skipping `lib/platform/`, and fails on any\ndirect use of an Electron API that has already been migrated behind\nthe shim (`shell` and `clipboard`; plus, since US-027, the\n`@electron/remote` dialog API and the `getCurrentWindow().isVisible` /\n`.isMaximized` reads; plus, since US-028, any import of `fs`; plus,\nsince US-029, `new remote.Menu` / `new remote.MenuItem`; plus, since\nUS-030..US-032, any use of `ipcRenderer` at all and any `wt-` channel\nstring; plus, since US-034, any `require()` of a banned host module).\nEach of US-027..US-032 added its concern to that list as it landed.\nReading source rather than build output is the point -- do not\nrepoint it at `build/`.\n\n**US-034 did not supersede this file.** The lint rule added there\n(`eslint-boundary.config.js`, run by `npm run lint:boundary` and\ncovered by `test/unit/lint-boundary.js`) bans the import\n**specifiers** -- `electron`, `@electron/remote`, `fs`, `os`,\n`crypto`, `http` -- under `src/renderer/`, with\n`src/renderer/lib/platform/` exempt by directory glob and no per-file\nexemption at all. (US-046 dropped the `webtorrent.js` override with\nthe file and US-079 dropped `lib/cast.js`'s the same way, closing\nADR-008; US-046 also added two per-file rules\nthat *tighten* rather than exempt: `lib/platform/ipc-engine.js` is\nbanned from Electron again, and `src/engine/**` -- the sidecar -- is\nbanned from Electron and from every DOM global while keeping Node\nbuiltins. `npm run lint:boundary` lints both trees; a test asserts the\nscript still names both.) It catches a brand new file reaching for a\nhost module,\nwhich the concern-based checks here would miss. It cannot see\n`ipcRenderer.` member reads, `wt-` channel strings, `new remote.Menu`,\nor any `require()` call, which is what this file is for. Add a new\nbanned **specifier** to the lint config; add a new banned **usage** to\nthis file.\n\n`lint-boundary.js` drives the config through ESLint's Node API\n(`new ESLint({ useEslintrc: false, overrideConfigFile })`) rather than\nshelling out, so it can `lintText()` synthetic sources at a chosen\n`filePath` and prove an exemption actually exempts without creating a\nthrowaway file under `src/`. Do not rewrite it to write probe files:\na crashed run would leave them behind for `standard` to trip over.\n\nThe OS-IPC check walked a hand-maintained file list while the\nmigration was partial. Since US-031 it walks the whole renderer, and\nsince US-032 -- with both IPC concerns migrated -- the OS and `wt-*`\nchecks collapsed into one: no `ipcRenderer` and no `wt-` string\nliteral anywhere outside `lib/platform/`, plus an exact assertion on\nwhich renderer files still import a host module at all (since US-039,\nnone). There is no \"left alone for a later story\" counterpart any\nmore, because there is nothing left. The Electron spellings it scans\nfor outlived the host: US-072 deleted every one of them, and the scan\nis what keeps a reflex from bringing one back.\n\nThe `fs` check is the one exception to the rule below: `fs` is a Node\nbuiltin with a single concern behind it, so it bans the specifier\noutright, with no exemption since US-045 deleted `webtorrent.js`.\n\nSince US-046 this file also scans `src/engine/` for the mirror-image\nmistake -- an Electron import or a DOM global in the sidecar -- and\nscans `lib/platform/ipc-engine.js`, which every renderer walk here\nskips because it is inside the shim.\n\nThe checks name **concerns, not module specifiers**. Add a pattern for\nwhat your story actually migrated, not for the import it happens to sit\nnext to. (Up to US-029 that mattered because `remote.Menu` and\n`remote.dialog` lived in the same file and left in different stories.)\n\n## Unit testing a controller\n\nControllers are outside `build:node`, so there is no prebuilt copy to\nrequire. `test/unit/torrent-context-menu.js` compiles the one file\nunder test with `@babel/core` (`transformFileSync(src, { root, cwd })`\npicks up the `babel` key in `package.json`) and writes the result into\n`build/renderer/controllers/`. Emitting it *there* is what makes the\ncontroller's own `../lib/...` imports resolve against the real built\n`build/renderer/lib/**`; a temp directory would not resolve at all.\nStub the shim modules it imports by `require.cache`-seeding their\nbuilt paths, and record dispatches through the real\n`lib/dispatcher`'s `setDispatch()` rather than stubbing it.\n\n`test/unit/os-ipc-call-sites.js` follows the same recipe for the\nUS-030 controllers and `test/unit/engine-ipc-call-sites.js` for the\nUS-032 ones. Cross-file hazards these had to solve, all because\n`tape test/unit/*.js` is a **single process** that requires every file\nbefore running any test:\n\n- **`setDispatch()` is process-wide.** Registering it once at require\n  time means the last file loaded wins for the entire run. Call\n  `setDispatch()` inside each file's per-test `reset()` instead.\n- **A `require.cache` stub of a *built shim module* leaks into later\n  files.** `platform-ipc-os.js` tests the real `ipc-os`, so a stub left\n  at its path breaks it. Withdraw the stub (restore the previous cache\n  entry, or `delete` it) right after requiring the module under test --\n  Babel binds the imported module object at that first require, so the\n  module under test keeps the stub afterwards. Stubs of a package that\n  is not itself a shim module -- `@tauri-apps/api/core`, say -- do not\n  need this; every file that cares seeds its own.\n- **Two files compiling the same controller collide.** The compiled\n  copy is keyed in `require.cache` by its emitted path, so whichever\n  file loads first hands its stubs to the other.\n  `engine-ipc-call-sites.js` emits under a `.engine-test.js` suffix\n  into the same directory, and `media-controller-playability.js` under\n  `.playability-test.js` (the directory is what resolves `../lib/...`,\n  not the file name). Both collide with `os-ipc-call-sites.js`, which\n  emits `media-controller.js` itself. Likewise\n  `torrent-list-resume.js` emits `torrent-list-controller` under\n  `.resume-test.js`, since `torrent-context-menu.js` owns the plain\n  name. The failure is silent and lands\n  in the *other* file: the loser's recorders stay empty while its own\n  assertions about the modal still pass, so run a new controller test\n  alongside the existing ones, both orders, before believing it.\n  The same collision used to bite two files that both required the\n  main process's `ipc` module; both those files went with the host in\n  US-072. The recipe they used is still the one to reach for when two\n  files need different stubs of the same built module:\n  `delete require.cache[...]` before requiring, then put the previous\n  entry back, so both instances keep the stubs they were built with.\n- **Stub every built module the controller graph reaches, not just the\n  one under test.** Letting a real shim module load here binds *this*\n  file's host stub into it for the whole run, which breaks\n  `platform-clipboard.js` / `platform-ipc-engine.js` later in the\n  glob. `playback-controller` reaches `lib/state` -> `lib/migrations`\n  that way, which is exactly what `migrations.js` tests against.\n- **`migrations.js` never withdraws its `build/config` stub.** It is\n  seeded at require time and left there for the rest of the run, so a\n  later file wanting its own config has to save the previous cache\n  entry, seed its own, `require()` the module under test, and put the\n  previous one back -- `state-file.js`'s `withConfig()` helper is the\n  shape. Pointing that stub's `CONFIG_PATH`, `POSTER_PATH` and\n  `TORRENT_PATH` at a `mkdtemp` directory is what makes it safe to run\n  the *real* `lib/platform/fs` against a throwaway profile.\n- **A recording wrapper beats a fake when the claim is \"it goes\n  through the shim\".** Require the real built shim first, wrap each\n  export in a function that pushes its arguments onto an array and\n  delegates, seed *that* at the shim's path, require the module under\n  test, then restore. The assertions are then about real filesystem\n  behaviour and about the routing at once, and anything reaching for\n  `fs` directly leaves no trace in the array.\n\n## Testing `src/renderer/main.js`\n\n`main.js` cannot be required in a unit test at all -- not even with\nthe compile-it-yourself recipe above. Its module body calls\n`State.load()`, and it pulls in React, ReactDOM, every page and the\nwhole controller graph. `test/unit/main-ipc-call-sites.js` therefore\nchecks it statically, but goes one step past a channel-string ban: it\nextracts every `ipcOs.x` / `ipcEngine.x` member the file reaches for\nand resolves each against the `export function` names in the shim\nsource, so a typo'd or invented export fails there instead of\nsilently becoming `undefined` at runtime. It also asserts the set of\nshim exports covers every channel `main.js` spoke before the\nmigration, which is the only automated guard against a channel being\ndropped.\n\nThe behaviour of the shim functions themselves stays in\n`platform-ipc-os.js` / `platform-ipc-engine.js`; do not duplicate it\nhere.\n\nWhat *is* testable is the emitted bundle, which\n`test/unit/renderer-boots.js` runs in a webview-shaped sandbox: a\n`vm` context with a minimal DOM and deliberately no `require`,\n`process`, `module` or `global`. Its `__TAURI_INTERNALS__.invoke`\nrecords every command and has two modes, and the difference matters:\n\n- **Nothing answers.** Every `invoke` returns a promise that never\n  settles, so startup stops at the first host call and the recorded\n  commands are exactly what the bundle asks for before it knows\n  anything. This is how the load itself and the startup *ordering*\n  are asserted.\n- **One command answers.** Resolve `app_paths` and leave the rest\n  pending, and startup advances exactly one step further -- far\n  enough to assert what the bundle did with the answer. US-072 needed\n  this: the bootstrap reached `useHostPaths` through the wrong export\n  and threw one tick after every other test had gone green.\n- **Enough answers to boot.** `app_paths`, `fs_read_file` with an\n  existing profile (bytes as a number array) and an id for each\n  `plugin:event|listen` take startup through `ReactDOM.render` and\n  `setupIpc`. Answer `fs_read_file` with a profile rather than an\n  error: a missing one makes `State.load` build the default torrents,\n  which fetches bundled assets. Keep every other command pending; a\n  `null` from `get_engine_endpoint` starts the engine client's retry\n  timers. Wrap the sandbox's `setInterval` and clear it afterwards,\n  because startup's once-a-second `update` holds the process open.\n\nAnything asserted in the second mode runs on a later tick, so wrap it\nin a `process.on('unhandledRejection')` capture. `main.js`'s\n`bootstrap()` deliberately has no `catch` -- there is no UI to report\ninto that early -- and an uncaught rejection there lands outside any\n`try` in the test file and takes the whole `tape` process with it.\n\n## Testing the engine sidecar\n\n`test/unit/engine-entry.js` runs the real thing: it spawns\n`build/engine/index.js` with `process.execPath`, waits for the\n`WEBTORRENT_ENGINE_PORT=` line on stdout, connects a real `ws` client\nand speaks `wt-*` through `build/shared/wire.js`. Four things keep that\nhonest and cheap:\n\n- **`NODE_ENV=test` in the child's env** makes `config` portable, so the\n  run cannot touch the real profile directory.\n- **A `static/*.torrent` fixture with every file deselected.** Metadata,\n  `wt-parsed`, `wt-ready` and `wt-progress` all arrive from the torrent\n  file itself, so the assertions do not need a peer -- and nothing\n  downloads.\n- **Kill the child in a `finally`, then await its `exit`.** A leaked\n  sidecar keeps a port and a download directory.\n- **Never patch module resolution in the tape process.** All unit files\n  share one process, so the \"config loads with no electron module\" check\n  runs the patch in a `spawnSync` child instead.\n\n`createWebSocketBus` is tested against a real server and a real client\nin `engine-bus-websocket.js` rather than a fake socket: the story is\nthat the engine is reachable by a plain socket, so a stub would only\ntest the stub. Wait on a condition (`waitFor`), never on a delay.\ntest:\nAGENTS.md\nfs-shim.js\nunit/\n\ntest/unit:\naudio-tracks.js\ncast-call-sites.js\ncast-mirror.js\nconfig-host-paths.js\ndispatcher.js\nelectron-removed.js\nengine-announce.js\nengine-audio-metadata-wiring.js\nengine-audio-metadata.js\nengine-bus-websocket.js\nengine-dials-wiring.js\nengine-dials.js\nengine-entry.js\nengine-hashfail-wiring.js\nengine-hashfail.js\nengine-ipc-call-sites.js\nengine-selections.js\nengine-stall.js\nengine-sweep-wiring.js\nengine-torrent-close-wiring.js\nerror-list.js\nfetch-node.js\nlint-boundary.js\nmain-ipc-call-sites.js\nmedia-controller-external-player.js\nmedia-controller-playability.js\nmedia-playability.js\nmigrations.js\nos-ipc-call-sites.js\nos.js\npath.js\nplatform-boundary.js\nplatform-cast.js\nplatform-clipboard.js\nplatform-dialog.js\nplatform-fs.js\nplatform-ipc-engine.js\nplatform-ipc-os.js\nplatform-menu.js\nplatform-paths.js\nplatform-shell.js\nplatform-stubs.js\nplatform-window.js\nplayback-controller-subscriptions.js\nposter.js\nrenderer-boots.js\nsidecar-closure.js\nsound.js\nstage-sidecar.js\nstate-file.js\nstatic-asset.js\nsync-crate-version.js\ntauri-host.js\ntime.js\ntorrent-context-menu.js\ntorrent-list-resume.js\ntorrent-status.js\nwire.js\n     456 src/renderer/controllers/playback-controller.js\nmemory-leaks/\nstartup-ipc-signals/","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"