{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebTorrent",
  "identifier": "io.webtorrent.webtorrent",
  "build": {
    "frontendDist": "../build-tauri",
    "beforeBundleCommand": "node bin/stage-sidecar.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WebTorrent",
        "url": "static/main.html",
        "visible": false,
        "width": 500,
        "height": 638,
        "minWidth": 425,
        "minHeight": 238,
        "backgroundColor": "#282828"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../build-sidecar/": "./"
    },
    "icon": [
      "../static/WebTorrent.icns",
      "../static/WebTorrent.png"
    ]
  }
}
